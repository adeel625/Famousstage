{% comment %}
  Testimonial Section with Carousel
  Desktop: 4 cards visible at a time (editable in theme settings)
  Mobile: 1 card visible at a time
  With Read More functionality, infinite smooth loop
{% endcomment %}

<div class="testimonial-section" id="shopify-section-{{ section.id }}">
  <div class="testimonial-container">
    
    <!-- Section Header -->
    {% if section.settings.heading != blank %}
      <div class="testimonial-header">
        <h2 class="testimonial-heading">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="testimonial-subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <!-- Testimonial Carousel -->
    <div class="testimonial-carousel-wrapper">
      <div class="testimonial-carousel-track" id="testimonialTrack-{{ section.id }}">
        <div class="testimonial-carousel" id="testimonialCarousel-{{ section.id }}">
          {% assign cards_per_row = section.settings.cards_per_row | default: 4 %}
          {% assign total_blocks = section.blocks | size %}
          
          <!-- Clone last few cards for infinite loop -->
          {% assign start_index = total_blocks | minus: cards_per_row %}
          {% if start_index < 0 %}{% assign start_index = 0 %}{% endif %}
          {% for block in section.blocks limit: cards_per_row offset: start_index %}
            <div class="testimonial-card clone" data-index="clone-start-{{ forloop.index0 }}">
              <div class="testimonial-card-inner">
                {% if section.settings.show_quote_icon %}
                  <div class="testimonial-quote-icon">
                    <span class="quote-comma">"</span>
                  </div>
                {% endif %}
                {% if section.settings.show_stars %}
                  <div class="testimonial-stars">
                    {% assign rating = block.settings.rating | default: 5 %}
                    {% for i in (1..5) %}
                      {% if i <= rating %}
                        <span class="star filled">★</span>
                      {% else %}
                        <span class="star empty">★</span>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}
                <div class="testimonial-text-wrapper">
                  <div class="testimonial-text" id="testimonialText-clone-{{ forloop.index0 }}">
                    {{ block.settings.testimonial }}
                  </div>
                  <button class="read-more-btn" data-target="testimonialText-clone-{{ forloop.index0 }}">
                    <span class="read-more-text">Read More</span>
                    <span class="read-less-text" style="display: none;">Read Less</span>
                  </button>
                </div>
                <div class="testimonial-author">
                  {% if block.settings.author_image != blank %}
                    <div class="author-image">
                      <img src="{{ block.settings.author_image | img_url: '100x100', crop: 'center' }}" 
                           alt="{{ block.settings.author_name }}" 
                           loading="lazy"
                           width="50" 
                           height="50">
                    </div>
                  {% endif %}
                  <div class="author-info">
                    <div class="author-name">{{ block.settings.author_name }}</div>
                    <div class="author-title">{{ block.settings.author_title }}</div>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
          
          <!-- Original cards -->
          {% for block in section.blocks %}
            <div class="testimonial-card" data-index="{{ forloop.index0 }}">
              <div class="testimonial-card-inner">
                
                <!-- Comma Icon -->
                {% if section.settings.show_quote_icon %}
                  <div class="testimonial-quote-icon">
                    <span class="quote-comma">"</span>
                  </div>
                {% endif %}
                
                <!-- Stars Rating -->
                {% if section.settings.show_stars %}
                  <div class="testimonial-stars">
                    {% assign rating = block.settings.rating | default: 5 %}
                    {% for i in (1..5) %}
                      {% if i <= rating %}
                        <span class="star filled">★</span>
                      {% else %}
                        <span class="star empty">★</span>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}
                
                <!-- Testimonial Text with Read More -->
                <div class="testimonial-text-wrapper">
                  <div class="testimonial-text" id="testimonialText-{{ block.id }}">
                    {{ block.settings.testimonial }}
                  </div>
                  <button class="read-more-btn" data-target="testimonialText-{{ block.id }}">
                    <span class="read-more-text">Read More</span>
                    <span class="read-less-text" style="display: none;">Read Less</span>
                  </button>
                </div>
                
                <!-- Author Info -->
                <div class="testimonial-author">
                  {% if block.settings.author_image != blank %}
                    <div class="author-image">
                      <img src="{{ block.settings.author_image | img_url: '100x100', crop: 'center' }}" 
                           alt="{{ block.settings.author_name }}" 
                           loading="lazy"
                           width="50" 
                           height="50">
                    </div>
                  {% endif %}
                  <div class="author-info">
                    <div class="author-name">{{ block.settings.author_name }}</div>
                    <div class="author-title">{{ block.settings.author_title }}</div>
                  </div>
                </div>
                
              </div>
            </div>
          {% endfor %}
          
          <!-- Clone first few cards for infinite loop -->
          {% for block in section.blocks limit: cards_per_row %}
            <div class="testimonial-card clone" data-index="clone-end-{{ forloop.index0 }}">
              <div class="testimonial-card-inner">
                {% if section.settings.show_quote_icon %}
                  <div class="testimonial-quote-icon">
                    <span class="quote-comma">"</span>
                  </div>
                {% endif %}
                {% if section.settings.show_stars %}
                  <div class="testimonial-stars">
                    {% assign rating = block.settings.rating | default: 5 %}
                    {% for i in (1..5) %}
                      {% if i <= rating %}
                        <span class="star filled">★</span>
                      {% else %}
                        <span class="star empty">★</span>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}
                <div class="testimonial-text-wrapper">
                  <div class="testimonial-text" id="testimonialText-clone-end-{{ forloop.index0 }}">
                    {{ block.settings.testimonial }}
                  </div>
                  <button class="read-more-btn" data-target="testimonialText-clone-end-{{ forloop.index0 }}">
                    <span class="read-more-text">Read More</span>
                    <span class="read-less-text" style="display: none;">Read Less</span>
                  </button>
                </div>
                <div class="testimonial-author">
                  {% if block.settings.author_image != blank %}
                    <div class="author-image">
                      <img src="{{ block.settings.author_image | img_url: '100x100', crop: 'center' }}" 
                           alt="{{ block.settings.author_name }}" 
                           loading="lazy"
                           width="50" 
                           height="50">
                    </div>
                  {% endif %}
                  <div class="author-info">
                    <div class="author-name">{{ block.settings.author_name }}</div>
                    <div class="author-title">{{ block.settings.author_title }}</div>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
      
      <!-- Navigation Arrows -->
      {% if section.blocks.size > section.settings.cards_per_row %}
        <button class="carousel-arrow prev-arrow" id="prevArrow-{{ section.id }}" aria-label="Previous testimonials">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button class="carousel-arrow next-arrow" id="nextArrow-{{ section.id }}" aria-label="Next testimonials">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {% endif %}
      
      <!-- Dots Navigation -->
      <div class="carousel-dots" id="dotsContainer-{{ section.id }}">
        {% assign cards_per_row = section.settings.cards_per_row | default: 4 %}
        {% assign total_slides = section.blocks.size | minus: cards_per_row | plus: 1 %}
        {% if total_slides < 1 %}{% assign total_slides = 1 %}{% endif %}
        {% for i in (1..total_slides) %}
          <span class="dot {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index0 }}"></span>
        {% endfor %}
      </div>
      
    </div>
  </div>
</div>

<style>
  /* ===== Testimonial Section Styles ===== */
  #shopify-section-{{ section.id }} .testimonial-section {
    padding: {{ section.settings.section_padding }}px 0;
    background-color: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .testimonial-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
  }

  /* ===== Header Styles ===== */
  #shopify-section-{{ section.id }} .testimonial-header {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: {{ section.settings.heading_spacing }}px;
  }

  #shopify-section-{{ section.id }} .testimonial-heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0 0 10px 0;
  }

  #shopify-section-{{ section.id }} .testimonial-subheading {
    font-size: {{ section.settings.subheading_size }}px;
    color: {{ section.settings.subheading_color }};
    margin: 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ===== Carousel Wrapper ===== */
  #shopify-section-{{ section.id }} .testimonial-carousel-wrapper {
    position: relative;
    overflow: visible;
    padding: 20px 50px;
  }

  #shopify-section-{{ section.id }} .testimonial-carousel-track {
    overflow: hidden;
    position: relative;
  }

  #shopify-section-{{ section.id }} .testimonial-carousel {
    display: flex;
    gap: {{ section.settings.card_gap }}px;
    transition: transform 0.5s ease;
    transform: translateX(0);
    width: 100%;
  }

  /* ===== Testimonial Card Styles ===== */
  #shopify-section-{{ section.id }} .testimonial-card {
    background: {{ section.settings.card_background }};
    border-radius: {{ section.settings.card_border_radius }}px;
    padding: {{ section.settings.card_padding }}px;
    box-shadow: {{ section.settings.card_shadow_horizontal }}px {{ section.settings.card_shadow_vertical }}px {{ section.settings.card_shadow_blur }}px rgba(0,0,0,{{ section.settings.card_shadow_opacity }});
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    position: relative;
    margin-top: 15px;
    margin-bottom: 15px;
    height: auto;
    flex: 0 0 calc((100% - {{ section.settings.card_gap }}px * ({{ section.settings.cards_per_row | default: 4 }} - 1)) / {{ section.settings.cards_per_row | default: 4 }});
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .testimonial-card:hover {
    transform: translateY(-3px);
    box-shadow: {{ section.settings.card_shadow_horizontal }}px {{ section.settings.card_shadow_vertical | plus: 5 }}px {{ section.settings.card_shadow_blur | plus: 10 }}px rgba(0,0,0,{{ section.settings.card_shadow_opacity | plus: 0.05 }});
    border-color: {{ section.settings.card_border_hover_color }};
  }

  #shopify-section-{{ section.id }} .testimonial-card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: space-between;
  }

  /* ===== Comma Icon ===== */
  #shopify-section-{{ section.id }} .testimonial-quote-icon {
    margin-bottom: 8px;
    color: {{ section.settings.quote_icon_color }};
    opacity: {{ section.settings.quote_icon_opacity }};
  }

  #shopify-section-{{ section.id }} .testimonial-quote-icon .quote-comma {
    font-size: 48px;
    font-weight: 700;
    line-height: 0.8;
    font-family: Georgia, serif;
    color: {{ section.settings.quote_icon_color }};
  }

  /* ===== Stars ===== */
  #shopify-section-{{ section.id }} .testimonial-stars {
    margin-bottom: 8px;
    display: flex;
    gap: 3px;
  }

  #shopify-section-{{ section.id }} .testimonial-stars .star {
    font-size: {{ section.settings.star_size }}px;
    color: {{ section.settings.star_color_empty }};
  }

  #shopify-section-{{ section.id }} .testimonial-stars .star.filled {
    color: {{ section.settings.star_color_filled }};
  }

  /* ===== Testimonial Text with Read More ===== */
  #shopify-section-{{ section.id }} .testimonial-text-wrapper {
    flex: 1;
    margin-bottom: 12px;
  }

  #shopify-section-{{ section.id }} .testimonial-text {
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    font-style: italic;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    transition: all 0.3s ease;
  }

  #shopify-section-{{ section.id }} .testimonial-text.expanded {
    -webkit-line-clamp: unset;
    display: block;
  }

  #shopify-section-{{ section.id }} .testimonial-text p {
    margin: 0 0 8px 0;
  }

  #shopify-section-{{ section.id }} .testimonial-text p:last-child {
    margin-bottom: 0;
  }

  /* ===== Read More Button ===== */
  #shopify-section-{{ section.id }} .read-more-btn {
    background: none;
    border: none;
    color: {{ section.settings.read_more_color | default: '#007bff' }};
    font-size: {{ section.settings.read_more_size | default: 14 }}px;
    font-weight: 600;
    cursor: pointer;
    padding: 4px 0;
    margin-top: 4px;
    transition: all 0.3s ease;
    font-family: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    display: inline-block;
  }

  #shopify-section-{{ section.id }} .read-more-btn:hover {
    color: {{ section.settings.read_more_hover_color | default: '#0056b3' }};
    opacity: 0.8;
  }

  #shopify-section-{{ section.id }} .read-more-btn:focus {
    outline: none;
  }

  /* ===== Author Section ===== */
  #shopify-section-{{ section.id }} .testimonial-author {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid {{ section.settings.divider_color }};
  }

  #shopify-section-{{ section.id }} .author-image {
    flex-shrink: 0;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid {{ section.settings.author_image_border_color }};
  }

  #shopify-section-{{ section.id }} .author-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .author-name {
    font-size: {{ section.settings.author_name_size }}px;
    font-weight: 700;
    color: {{ section.settings.author_name_color }};
    margin: 0 0 1px 0;
  }

  #shopify-section-{{ section.id }} .author-title {
    font-size: {{ section.settings.author_title_size }}px;
    color: {{ section.settings.author_title_color }};
    margin: 0;
  }

  /* ===== Navigation Arrows ===== */
  #shopify-section-{{ section.id }} .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: {{ section.settings.arrow_background }};
    color: {{ section.settings.arrow_color }};
    border: 2px solid {{ section.settings.arrow_border_color }};
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.12);
    padding: 0;
  }

  #shopify-section-{{ section.id }} .carousel-arrow:hover {
    background: {{ section.settings.arrow_hover_background }};
    color: {{ section.settings.arrow_hover_color }};
    transform: translateY(-50%) scale(1.08);
  }

  #shopify-section-{{ section.id }} .carousel-arrow:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    transform: translateY(-50%) scale(0.95);
  }

  #shopify-section-{{ section.id }} .prev-arrow {
    left: -15px;
  }

  #shopify-section-{{ section.id }} .next-arrow {
    right: -15px;
  }

  /* ===== Dots Navigation ===== */
  #shopify-section-{{ section.id }} .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 25px;
  }

  #shopify-section-{{ section.id }} .carousel-dots .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: {{ section.settings.dot_color_inactive }};
    cursor: pointer;
    transition: all 0.3s ease;
  }

  #shopify-section-{{ section.id }} .carousel-dots .dot.active {
    background: {{ section.settings.dot_color_active }};
    transform: scale(1.2);
    width: 30px;
    border-radius: 6px;
  }

  /* ===== Hide scrollbar ===== */
  #shopify-section-{{ section.id }} .testimonial-carousel-track {
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  #shopify-section-{{ section.id }} .testimonial-carousel-track::-webkit-scrollbar {
    display: none;
  }

  /* ===== Tablet Responsive ===== */
  @media screen and (max-width: 1024px) {
    #shopify-section-{{ section.id }} .testimonial-card {
      flex: 0 0 calc((100% - {{ section.settings.card_gap }}px * 2) / 3);
    }
    
    #shopify-section-{{ section.id }} .carousel-arrow {
      width: 38px;
      height: 38px;
    }
    
    #shopify-section-{{ section.id }} .carousel-arrow svg {
      width: 18px;
      height: 18px;
    }
    
    #shopify-section-{{ section.id }} .prev-arrow {
      left: -10px;
    }
    
    #shopify-section-{{ section.id }} .next-arrow {
      right: -10px;
    }
    
    #shopify-section-{{ section.id }} .testimonial-text {
      -webkit-line-clamp: 3;
    }
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .testimonial-card {
      flex: 0 0 calc((100% - {{ section.settings.card_gap }}px) / 2);
    }
    
    #shopify-section-{{ section.id }} .carousel-arrow {
      width: 34px;
      height: 34px;
    }
    
    #shopify-section-{{ section.id }} .carousel-arrow svg {
      width: 16px;
      height: 16px;
    }
    
    #shopify-section-{{ section.id }} .testimonial-carousel-wrapper {
      padding: 20px 15px;
    }
    
    #shopify-section-{{ section.id }} .testimonial-text {
      -webkit-line-clamp: 3;
    }
  }

  /* ===== Mobile Responsive ===== */
  @media screen and (max-width: 640px) {
    #shopify-section-{{ section.id }} .testimonial-section {
      padding: {{ section.settings.mobile_section_padding }}px 0;
    }

    #shopify-section-{{ section.id }} .testimonial-heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #shopify-section-{{ section.id }} .testimonial-subheading {
      font-size: {{ section.settings.mobile_subheading_size }}px;
    }

    #shopify-section-{{ section.id }} .testimonial-carousel-wrapper {
      padding: 10px 0;
    }

    #shopify-section-{{ section.id }} .testimonial-carousel {
      display: flex;
      flex-direction: row;
      gap: 0;
      transition: transform 0.5s ease;
      width: auto;
    }

    #shopify-section-{{ section.id }} .testimonial-card {
      flex: 0 0 100%;
      max-width: 100%;
      padding: {{ section.settings.mobile_card_padding }}px;
      margin: 15px 5px;
      min-width: 0;
      min-height: auto;
    }

    #shopify-section-{{ section.id }} .testimonial-text {
      font-size: {{ section.settings.mobile_text_size }}px;
      -webkit-line-clamp: 3;
    }

    #shopify-section-{{ section.id }} .testimonial-text.expanded {
      -webkit-line-clamp: unset;
      display: block;
    }

    #shopify-section-{{ section.id }} .read-more-btn {
      font-size: {{ section.settings.mobile_read_more_size | default: 13 }}px;
    }

    #shopify-section-{{ section.id }} .author-name {
      font-size: {{ section.settings.mobile_author_name_size }}px;
    }

    #shopify-section-{{ section.id }} .author-title {
      font-size: {{ section.settings.mobile_author_title_size }}px;
    }

    #shopify-section-{{ section.id }} .author-image {
      width: 44px;
      height: 44px;
    }

    #shopify-section-{{ section.id }} .carousel-arrow {
      width: 30px;
      height: 30px;
      display: none;
    }

    #shopify-section-{{ section.id }} .carousel-arrow svg {
      width: 14px;
      height: 14px;
    }

    #shopify-section-{{ section.id }} .prev-arrow {
      left: -5px;
    }

    #shopify-section-{{ section.id }} .next-arrow {
      right: -5px;
    }

    #shopify-section-{{ section.id }} .carousel-dots {
      margin-top: 15px;
      gap: 8px;
    }

    #shopify-section-{{ section.id }} .carousel-dots .dot {
      width: 10px;
      height: 10px;
    }

    #shopify-section-{{ section.id }} .carousel-dots .dot.active {
      width: 25px;
    }

    #shopify-section-{{ section.id }} .testimonial-stars .star {
      font-size: {{ section.settings.mobile_star_size }}px;
    }

    #shopify-section-{{ section.id }} .testimonial-quote-icon .quote-comma {
      font-size: 38px;
    }

    #shopify-section-{{ section.id }} .testimonial-header {
      margin-bottom: {{ section.settings.mobile_heading_spacing }}px;
    }
    
    #shopify-section-{{ section.id }} .testimonial-quote-icon {
      margin-bottom: 5px;
    }
    
    #shopify-section-{{ section.id }} .testimonial-stars {
      margin-bottom: 5px;
    }

    #shopify-section-{{ section.id }} .testimonial-text-wrapper {
      margin-bottom: 8px;
    }
  }

  /* ===== Small Mobile ===== */
  @media screen and (max-width: 400px) {
    #shopify-section-{{ section.id }} .testimonial-card {
      padding: {{ section.settings.small_mobile_card_padding }}px;
      margin: 12px 3px;
    }
    
    #shopify-section-{{ section.id }} .testimonial-quote-icon .quote-comma {
      font-size: 32px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = '{{ section.id }}';
    const carousel = document.getElementById('testimonialCarousel-' + sectionId);
    const prevBtn = document.getElementById('prevArrow-' + sectionId);
    const nextBtn = document.getElementById('nextArrow-' + sectionId);
    const dotsContainer = document.getElementById('dotsContainer-' + sectionId);
    
    // ===== Read More Functionality =====
    const readMoreBtns = document.querySelectorAll('#shopify-section-' + sectionId + ' .read-more-btn');
    
    readMoreBtns.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        const targetId = this.getAttribute('data-target');
        const textElement = document.getElementById(targetId);
        const readMoreText = this.querySelector('.read-more-text');
        const readLessText = this.querySelector('.read-less-text');
        
        if (textElement) {
          textElement.classList.toggle('expanded');
          
          if (textElement.classList.contains('expanded')) {
            readMoreText.style.display = 'none';
            readLessText.style.display = 'inline';
          } else {
            readMoreText.style.display = 'inline';
            readLessText.style.display = 'none';
          }
        }
      });
    });
    
    // ===== Carousel Functionality =====
    if (!carousel) return;
    
    const allCards = carousel.querySelectorAll('.testimonial-card');
    const totalCards = allCards.length;
    const cardsPerView = {{ section.settings.cards_per_row | default: 4 }};
    const actualCards = {{ section.blocks.size }};
    let currentIndex = 0;
    let autoPlayInterval;
    let isTransitioning = false;
    
    function getCardsPerView() {
      const width = window.innerWidth;
      if (width <= 640) return 1;
      if (width <= 768) return 2;
      if (width <= 1024) return 3;
      return {{ section.settings.cards_per_row | default: 4 }};
    }
    
    function getTotalDots() {
      const currentCardsPerView = getCardsPerView();
      return Math.max(1, Math.ceil(actualCards / currentCardsPerView));
    }
    
    function getCurrentDotIndex() {
      const currentCardsPerView = getCardsPerView();
      return Math.floor(currentIndex / currentCardsPerView);
    }
    
    function updateCarousel(animate = true) {
      if (isTransitioning) return;
      
      const currentCardsPerView = getCardsPerView();
      const maxIndex = totalCards - currentCardsPerView;
      let targetIndex = Math.min(currentIndex, maxIndex);
      
      if (targetIndex < 0) {
        targetIndex = 0;
        currentIndex = 0;
      }
      
      // Calculate percentage to slide
      const slidePercent = (targetIndex * 100) / currentCardsPerView;
      
      if (!animate) {
        carousel.style.transition = 'none';
      } else {
        carousel.style.transition = 'transform 0.5s ease';
      }
      
      carousel.style.transform = 'translateX(-' + slidePercent + '%)';
      
      // Update dots
      if (dotsContainer) {
        const dots = dotsContainer.querySelectorAll('.dot');
        const totalDots = getTotalDots();
        const dotIndex = getCurrentDotIndex();
        
        dots.forEach((dot, index) => {
          if (index < totalDots) {
            dot.style.display = 'inline-block';
            dot.classList.toggle('active', index === dotIndex);
          } else {
            dot.style.display = 'none';
          }
        });
      }
      
      // Update buttons
      if (prevBtn) {
        prevBtn.disabled = false;
      }
      if (nextBtn) {
        nextBtn.disabled = false;
      }
    }
    
    function nextSlide() {
      if (isTransitioning) return;
      
      const currentCardsPerView = getCardsPerView();
      const maxIndex = totalCards - currentCardsPerView;
      const nextIndex = currentIndex + 1;
      
      if (nextIndex <= maxIndex) {
        currentIndex = nextIndex;
        updateCarousel(true);
      } else {
        // At the end, jump to the beginning
        currentIndex = 0;
        updateCarousel(true);
      }
    }
    
    function prevSlide() {
      if (isTransitioning) return;
      
      if (currentIndex > 0) {
        currentIndex--;
        updateCarousel(true);
      } else {
        // At the beginning, jump to the end
        const currentCardsPerView = getCardsPerView();
        const maxIndex = totalCards - currentCardsPerView;
        currentIndex = maxIndex;
        updateCarousel(true);
      }
    }
    
    function goToSlide(index) {
      const totalDots = getTotalDots();
      const currentCardsPerView = getCardsPerView();
      
      if (index >= 0 && index < totalDots) {
        const newIndex = index * currentCardsPerView;
        const maxIndex = totalCards - currentCardsPerView;
        currentIndex = Math.min(newIndex, maxIndex);
        updateCarousel(true);
        resetAutoPlay();
      }
    }
    
    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        nextSlide();
        resetAutoPlay();
      });
    }
    
    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        prevSlide();
        resetAutoPlay();
      });
    }
    
    if (dotsContainer) {
      dotsContainer.addEventListener('click', function(e) {
        const dot = e.target.closest('.dot');
        if (dot) {
          const index = parseInt(dot.dataset.slide);
          if (!isNaN(index)) {
            goToSlide(index);
          }
        }
      });
    }
    
    // Handle transition end for infinite loop
    carousel.addEventListener('transitionend', function() {
      isTransitioning = false;
      
      const currentCardsPerView = getCardsPerView();
      const maxIndex = totalCards - currentCardsPerView;
      
      // If we're at the end of the cloned cards, jump to the beginning
      if (currentIndex >= actualCards) {
        currentIndex = currentIndex - actualCards;
        if (currentIndex < 0) currentIndex = 0;
        carousel.style.transition = 'none';
        const slidePercent = (currentIndex * 100) / currentCardsPerView;
        carousel.style.transform = 'translateX(-' + slidePercent + '%)';
        setTimeout(() => {
          carousel.style.transition = 'transform 0.5s ease';
        }, 50);
      }
      
      // If we're at the beginning (negative), jump to the end
      if (currentIndex < 0) {
        currentIndex = actualCards - currentCardsPerView;
        if (currentIndex < 0) currentIndex = 0;
        carousel.style.transition = 'none';
        const slidePercent = (currentIndex * 100) / currentCardsPerView;
        carousel.style.transform = 'translateX(-' + slidePercent + '%)';
        setTimeout(() => {
          carousel.style.transition = 'transform 0.5s ease';
        }, 50);
      }
    });
    
    function startAutoPlay() {
      if (actualCards > getCardsPerView()) {
        stopAutoPlay();
        autoPlayInterval = setInterval(nextSlide, {{ section.settings.auto_play_speed }} * 1000);
      }
    }
    
    function stopAutoPlay() {
      if (autoPlayInterval) {
        clearInterval(autoPlayInterval);
        autoPlayInterval = null;
      }
    }
    
    function resetAutoPlay() {
      stopAutoPlay();
      startAutoPlay();
    }
    
    let resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function() {
        const currentCardsPerView = getCardsPerView();
        const maxIndex = totalCards - currentCardsPerView;
        if (currentIndex > maxIndex) {
          currentIndex = maxIndex;
        }
        updateCarousel(false);
        resetAutoPlay();
      }, 250);
    });
    
    // Initialize
    setTimeout(function() {
      updateCarousel(false);
      setTimeout(function() {
        updateCarousel(true);
      }, 100);
    }, 100);
    startAutoPlay();
    
    const wrapper = document.querySelector('#shopify-section-{{ section.id }} .testimonial-carousel-wrapper');
    if (wrapper) {
      wrapper.addEventListener('mouseenter', function() {
        if ({{ section.settings.pause_on_hover | json }}) {
          stopAutoPlay();
        }
      });
      
      wrapper.addEventListener('mouseleave', function() {
        if ({{ section.settings.pause_on_hover | json }}) {
          startAutoPlay();
        }
      });
    }
    
    let touchStartX = 0;
    let touchEndX = 0;
    
    carousel.addEventListener('touchstart', function(e) {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });
    
    carousel.addEventListener('touchend', function(e) {
      touchEndX = e.changedTouches[0].screenX;
      const swipeThreshold = 50;
      const diff = touchStartX - touchEndX;
      
      if (Math.abs(diff) > swipeThreshold) {
        if (diff > 0) {
          nextSlide();
        } else {
          prevSlide();
        }
        resetAutoPlay();
      }
    }, { passive: true });
  });
</script>

