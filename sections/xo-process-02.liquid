<section class="xo-section xo-section--T5xRZ8">
  <style>
    
    
    .xo-custom-1650686756508 { font-size: 36px !important; }
  </style>
  <div class="xo-container">
    <div class="xo-row xo-align-items-center" style="--xo-gutter-x: 3rem;">
      <div class="xo-col-md-6">
        <div class="xo-m-item xo-m-textbox xo-m-textbox-02">
          <h2 class="xo-m-textbox__heading xo-styles-h2-default xo-custom-1650686756508">{{ section.settings.heading00 }}</h2>
          <div class="xo-m-textbox__subheading xo-styles-text-default">{{ section.settings.subheading00 }}</div>
          <div class="xo-m-textbox__text xo-styles-text-default">{{ section.settings.text00 }}</div>
          {%- if section.settings.button00label != blank -%}
            <div class="xo-btn xo-m-textbox__btn xo-styles-1647186976948">
              <a href="{{ section.settings.button00 }}">
                <span>{{ section.settings.button00label }}</span>
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>
      <div class="xo-col-md-6">
        <div class=" xo-row xo-row-cols-1" style="--xo-repeat-ver-space: 20px; --xo-gutter-x: 20px;">
          {%- for block in section.blocks -%}
            <div class="xo-repeat__item xo-col" {{ block.shopify_attributes }}>
              <div class="xo-m-item xo-m-process xo-m-box--left xo-m-process-03 xo-styles-1650684476130">
                <div class="xo-m-box__left">
                  <div class="xo-m-process__step xo-styles-1650624527075">{{ block.settings.step0 }}</div>
                </div>
                <div class="xo-m-box__right">
                  <h3 class="xo-m-process__heading xo-styles-h3-default">{{ block.settings.heading0 }}</h3>
                  <div class="xo-m-process__text xo-styles-text-default">{{ block.settings.text0 }}</div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>
{% stylesheet %}
  /*CSTYLES*/
  @media only screen and (min-width: 768px){.xo-section--T5xRZ8 .xo-repeat__item:nth-child(1){margin-right:20px}.xo-section--T5xRZ8 .xo-repeat__item:nth-child(2){margin-left:50px}.xo-section--T5xRZ8 .xo-repeat__item:nth-child(3){margin-right:20px;margin-left:20px}.xo-section--T5xRZ8 .xo-repeat__item:nth-child(4){margin-left:50px}.xo-section--T5xRZ8 .xo-repeat__item:nth-child(5){margin-right:20px}}
{% endstylesheet %}

