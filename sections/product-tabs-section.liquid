{% if product %}
  <div class="product-tabs-section" data-section-id="{{ section.id }}" data-section-type="product-tabs">
    <div class="page-width">
      
      <!-- Section Title -->
      {% if section.settings.section_title != blank %}
        <h2 class="section-title">{{ section.settings.section_title }}</h2>
      {% endif %}
      
      <div class="tabs-wrapper">
        <ul class="tabs-nav" role="tablist">
          <li class="tab-item active" role="tab" data-tab="additional-info">
            {{ section.settings.tab_1_label | default: 'Additional Information' }}
          </li>
          <li class="tab-item" role="tab" data-tab="faq">
            {{ section.settings.tab_2_label | default: 'Frequently Asked Questions' }}
          </li>
        </ul>
        
        <div class="tabs-content">
          
          <!-- ========================================== -->
          <!-- TAB 1: ADDITIONAL INFORMATION               -->
          <!-- ========================================== -->
          <div class="tab-panel active" id="additional-info" role="tabpanel">
            <div class="additional-info-content">
              
              <!-- Additional Information BLOCKS -->
              {% if section.blocks.size > 0 %}
                {% for block in section.blocks %}
                  {% if block.type == 'info_block' %}
                    <div class="info-block" {{ block.shopify_attributes }}>
                      {% if block.settings.info_title != blank %}
                        <h3 class="info-title">{{ block.settings.info_title }}</h3>
                      {% endif %}
                      {% if block.settings.info_description != blank %}
                        <div class="info-description">
                          {{ block.settings.info_description }}
                        </div>
                      {% endif %}
                    </div>
                  {% endif %}
                {% endfor %}
              {% else %}
                <!-- Fallback: Agar koi block nahi hai toh product description show ho -->
                <div class="info-block">
                  <h3 class="info-title">{{ section.settings.default_info_title | default: 'Product Details' }}</h3>
                  <div class="info-description">
                    {{ product.description }}
                  </div>
                </div>
                <p class="info-placeholder">{{ section.settings.empty_info_message | default: 'No additional information added yet. Click "Add block" to add information blocks.' }}</p>
              {% endif %}
              
            </div>
          </div>
          
          <!-- ========================================== -->
          <!-- TAB 2: FAQ                                  -->
          <!-- ========================================== -->
          <div class="tab-panel" id="faq" role="tabpanel">
            <div class="faq-content">
              
              <!-- FAQ BLOCKS -->
              {% if section.blocks.size > 0 %}
                {% for block in section.blocks %}
                  {% if block.type == 'faq_item' %}
                    <div class="faq-item" {{ block.shopify_attributes }}>
                      <div class="faq-question" data-toggle="collapse">
                        <span>{{ block.settings.question }}</span>
                        <span class="faq-toggle">+</span>
                      </div>
                      <div class="faq-answer" style="display: none;">
                        {{ block.settings.answer }}
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
              {% else %}
                <p class="faq-placeholder">{{ section.settings.empty_faq_message | default: 'No FAQ items added yet. Click "Add block" to add FAQ items.' }}</p>
              {% endif %}
              
            </div>
          </div>
          
        </div>
      </div>
    </div>
  </div>

  <style>
    .product-tabs-section {
      margin: 40px 0;
      padding: 0 20px;
    }
    .product-tabs-section .page-width {
      max-width: 1200px;
      margin: 0 auto;
    }
    .section-title {
      text-align: center;
      font-size: 28px;
      font-weight: 700;
      margin-bottom: 30px;
      color: #000;
    }
    .tabs-nav {
      display: flex;
      list-style: none;
      padding: 0;
      margin: 0 0 20px 0;
      border-bottom: 2px solid #eaeaea;
      flex-wrap: wrap;
    }
    .tab-item {
      padding: 12px 24px;
      cursor: pointer;
      font-weight: 600;
      color: #666;
      border-bottom: 3px solid transparent;
      margin-bottom: -2px;
      transition: all 0.3s ease;
      user-select: none;
    }
    .tab-item.active {
      color: #000;
      border-bottom-color: #000;
    }
    .tab-item:hover {
      color: #000;
    }
    .tab-panel {
      display: none;
      padding: 20px 0;
      animation: fadeIn 0.3s ease;
    }
    .tab-panel.active {
      display: block;
    }
    
    /* Additional Information Styles */
    .additional-info-content .info-block {
      margin-bottom: 30px;
      padding-bottom: 30px;
      border-bottom: 1px solid #f0f0f0;
    }
    .additional-info-content .info-block:last-child {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }
    .additional-info-content .info-title {
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 15px;
      color: #000;
    }
    .additional-info-content .info-description {
      color: #333;
      line-height: 1.8;
    }
    .additional-info-content .info-description p {
      margin: 0 0 15px 0;
    }
    .info-placeholder {
      color: #999;
      font-style: italic;
      padding: 20px 0;
      text-align: center;
    }
    
    /* FAQ Styles */
    .faq-item {
      border-bottom: 1px solid #eaeaea;
      padding: 12px 0;
    }
    .faq-item:last-child {
      border-bottom: none;
    }
    .faq-question {
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      font-weight: 500;
      font-size: 16px;
      padding: 4px 0;
    }
    .faq-question .faq-toggle {
      font-size: 22px;
      transition: transform 0.3s ease;
      color: #333;
    }
    .faq-question.active .faq-toggle {
      transform: rotate(45deg);
    }
    .faq-answer {
      padding-top: 12px;
      color: #555;
      line-height: 1.8;
    }
    .faq-answer p {
      margin: 5px 0;
    }
    .faq-placeholder {
      color: #999;
      font-style: italic;
      padding: 20px 0;
      text-align: center;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    @media (max-width: 768px) {
      .tab-item {
        padding: 10px 16px;
        font-size: 14px;
        flex: 1;
        text-align: center;
      }
      .product-tabs-section {
        margin: 20px 0;
        padding: 0 12px;
      }
      .faq-question {
        font-size: 14px;
      }
      .section-title {
        font-size: 22px;
      }
      .additional-info-content .info-title {
        font-size: 17px;
      }
    }
  </style>

  <script>
    (function() {
      const sectionId = {{ section.id | json }};
      const container = document.querySelector(`[data-section-id="${sectionId}"]`);
      if (!container) return;
      
      // Tab switching
      const tabs = container.querySelectorAll('.tab-item');
      const panels = {
        'additional-info': container.querySelector('#additional-info'),
        'faq': container.querySelector('#faq')
      };
      
      tabs.forEach(tab => {
        tab.addEventListener('click', function() {
          tabs.forEach(t => t.classList.remove('active'));
          this.classList.add('active');
          
          const tabId = this.dataset.tab;
          Object.keys(panels).forEach(key => {
            if (panels[key]) {
              panels[key].classList.toggle('active', key === tabId);
            }
          });
        });
      });
      
      // FAQ toggle
      const faqQuestions = container.querySelectorAll('.faq-question');
      faqQuestions.forEach(question => {
        question.addEventListener('click', function() {
          this.classList.toggle('active');
          const answer = this.nextElementSibling;
          if (answer && answer.classList.contains('faq-answer')) {
            if (answer.style.display === 'none' || answer.style.display === '') {
              answer.style.display = 'block';
            } else {
              answer.style.display = 'none';
            }
          }
        });
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Product Tabs Section",
  "class": "shopify-section-product-tabs",
  "settings": [
    {
      "type": "header",
      "content": "📋 Section Settings"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Product Information",
      "info": "Leave empty to hide"
    },
    {
      "type": "header",
      "content": "📑 Tab Labels"
    },
    {
      "type": "text",
      "id": "tab_1_label",
      "label": "Tab 1 Label",
      "default": "Additional Information"
    },
    {
      "type": "text",
      "id": "tab_2_label",
      "label": "Tab 2 Label",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "header",
      "content": "📝 Default Content (Fallback)"
    },
    {
      "type": "text",
      "id": "default_info_title",
      "label": "Default Info Title",
      "default": "Product Details",
      "info": "Tabhi show hoga jab koi info block nahi ho"
    },
    {
      "type": "text",
      "id": "empty_info_message",
      "label": "Empty Info Message",
      "default": "No additional information added yet. Click \"Add block\" to add information blocks."
    },
    {
      "type": "text",
      "id": "empty_faq_message",
      "label": "Empty FAQ Message",
      "default": "No FAQ items added yet. Click \"Add block\" to add FAQ items."
    }
  ],
  "blocks": [
    {
      "type": "info_block",
      "name": "Info Block",
      "settings": [
        {
          "type": "text",
          "id": "info_title",
          "label": "Title",
          "default": "Product Details",
          "info": "Title for this information block"
        },
        {
          "type": "richtext",
          "id": "info_description",
          "label": "Description",
          "default": "<p>Add your custom product information here.</p>",
          "info": "Rich text editor - you can add paragraphs, lists, bold, italic, etc."
        }
      ]
    },
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your return policy?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We offer a 30-day return policy for all products.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Tabs Section",
      "category": "Product",
      "blocks": [
        {
          "type": "info_block",
          "settings": {
            "info_title": "Product Details",
            "info_description": "<p>This is where you can add detailed product information.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>We offer a 30-day return policy for all products.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Shipping typically takes 3-5 business days.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}