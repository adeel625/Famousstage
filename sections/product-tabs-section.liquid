{% if product %}
  <div class="product-tabs-section" data-section-id="{{ section.id }}" data-section-type="product-tabs">
    <div class="page-width">
      <div class="tabs-wrapper">
        <ul class="tabs-nav" role="tablist">
          <li class="tab-item active" role="tab" data-tab="additional-info">
            {{ section.settings.tab_1_label | default: 'Additional Information' }}
          </li>
          <li class="tab-item" role="tab" data-tab="faq">
            {{ section.settings.tab_2_label | default: 'FAQ' }}
          </li>
        </ul>
        
        <div class="tabs-content">
          <!-- Tab 1: Additional Information -->
          <div class="tab-panel active" id="additional-info" role="tabpanel">
            <div class="description-content">
              {{ product.description }}
            </div>
          </div>
          
          <!-- Tab 2: FAQ -->
          <div class="tab-panel" id="faq" role="tabpanel">
            <div class="faq-content">
              {% if section.settings.faq_question_1 != blank %}
                <div class="faq-item">
                  <div class="faq-question">
                    <span>{{ section.settings.faq_question_1 }}</span>
                    <span class="faq-toggle">+</span>
                  </div>
                  <div class="faq-answer" style="display: none;">
                    {{ section.settings.faq_answer_1 }}
                  </div>
                </div>
              {% endif %}
              
              {% if section.settings.faq_question_2 != blank %}
                <div class="faq-item">
                  <div class="faq-question">
                    <span>{{ section.settings.faq_question_2 }}</span>
                    <span class="faq-toggle">+</span>
                  </div>
                  <div class="faq-answer" style="display: none;">
                    {{ section.settings.faq_answer_2 }}
                  </div>
                </div>
              {% endif %}
              
              {% if section.settings.faq_question_3 != blank %}
                <div class="faq-item">
                  <div class="faq-question">
                    <span>{{ section.settings.faq_question_3 }}</span>
                    <span class="faq-toggle">+</span>
                  </div>
                  <div class="faq-answer" style="display: none;">
                    {{ section.settings.faq_answer_3 }}
                  </div>
                </div>
              {% endif %}
              
              {% if section.settings.faq_question_4 != blank %}
                <div class="faq-item">
                  <div class="faq-question">
                    <span>{{ section.settings.faq_question_4 }}</span>
                    <span class="faq-toggle">+</span>
                  </div>
                  <div class="faq-answer" style="display: none;">
                    {{ section.settings.faq_answer_4 }}
                  </div>
                </div>
              {% endif %}
              
              {% if section.settings.faq_question_5 != blank %}
                <div class="faq-item">
                  <div class="faq-question">
                    <span>{{ section.settings.faq_question_5 }}</span>
                    <span class="faq-toggle">+</span>
                  </div>
                  <div class="faq-answer" style="display: none;">
                    {{ section.settings.faq_answer_5 }}
                  </div>
                </div>
              {% endif %}
              
              {% if section.settings.faq_question_1 == blank and section.settings.faq_question_2 == blank and section.settings.faq_question_3 == blank and section.settings.faq_question_4 == blank and section.settings.faq_question_5 == blank %}
                <p class="faq-placeholder">{{ section.settings.empty_message | default: 'Add your FAQ items in the theme customizer.' }}</p>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .product-tabs-section {
      margin: 40px 0;
      padding: 0 20px;
    }
    .product-tabs-section .page-width {
      max-width: 1200px;
      margin: 0 auto;
    }
    .tabs-nav {
      display: flex;
      list-style: none;
      padding: 0;
      margin: 0 0 20px 0;
      border-bottom: 2px solid #eaeaea;
      flex-wrap: wrap;
    }
    .tab-item {
      padding: 12px 24px;
      cursor: pointer;
      font-weight: 600;
      color: #666;
      border-bottom: 3px solid transparent;
      margin-bottom: -2px;
      transition: all 0.3s ease;
      user-select: none;
    }
    .tab-item.active {
      color: #000;
      border-bottom-color: #000;
    }
    .tab-item:hover {
      color: #000;
    }
    .tab-panel {
      display: none;
      padding: 20px 0;
      animation: fadeIn 0.3s ease;
    }
    .tab-panel.active {
      display: block;
    }
    .faq-item {
      border-bottom: 1px solid #eaeaea;
      padding: 12px 0;
    }
    .faq-item:last-child {
      border-bottom: none;
    }
    .faq-question {
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      font-weight: 500;
      font-size: 16px;
      padding: 4px 0;
    }
    .faq-question .faq-toggle {
      font-size: 22px;
      transition: transform 0.3s ease;
      color: #333;
    }
    .faq-question.active .faq-toggle {
      transform: rotate(45deg);
    }
    .faq-answer {
      padding-top: 12px;
      color: #555;
      line-height: 1.8;
    }
    .faq-answer p {
      margin: 5px 0;
    }
    .faq-placeholder {
      color: #999;
      font-style: italic;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @media (max-width: 768px) {
      .tab-item {
        padding: 10px 16px;
        font-size: 14px;
        flex: 1;
        text-align: center;
      }
      .product-tabs-section {
        margin: 20px 0;
        padding: 0 12px;
      }
      .faq-question {
        font-size: 14px;
      }
    }
  </style>

  <script>
    (function() {
      const sectionId = {{ section.id | json }};
      const container = document.querySelector(`[data-section-id="${sectionId}"]`);
      if (!container) return;
      
      // Tab switching
      const tabs = container.querySelectorAll('.tab-item');
      const panels = {
        'additional-info': container.querySelector('#additional-info'),
        'faq': container.querySelector('#faq')
      };
      
      tabs.forEach(tab => {
        tab.addEventListener('click', function() {
          tabs.forEach(t => t.classList.remove('active'));
          this.classList.add('active');
          
          const tabId = this.dataset.tab;
          Object.keys(panels).forEach(key => {
            if (panels[key]) {
              panels[key].classList.toggle('active', key === tabId);
            }
          });
        });
      });
      
      // FAQ toggle
      const faqQuestions = container.querySelectorAll('.faq-question');
      faqQuestions.forEach(question => {
        question.addEventListener('click', function() {
          this.classList.toggle('active');
          const answer = this.nextElementSibling;
          if (answer && answer.classList.contains('faq-answer')) {
            if (answer.style.display === 'none' || answer.style.display === '') {
              answer.style.display = 'block';
            } else {
              answer.style.display = 'none';
            }
          }
        });
      });
    })();
  </script>
{% endif %}

{% schema %}
