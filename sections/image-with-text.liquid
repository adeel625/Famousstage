{% render 'section-open', section: section, type: 'image-with-text', title: false %}

  <style>
    /* ===== MAIN CONTAINER ===== */
    #shopify-section-{{ section.id }} {
      padding: 20px 0;
    }
    
    #shopify-section-{{ section.id }} .image-with-text-section-inner {
      display: flex;
      align-items: center;
      gap: 40px;
      max-width: 1200px;
      margin: 0 auto;
    }
    
    #shopify-section-{{ section.id }} .image-with-text-section-inner .cell {
      flex: 1;
      width: 50%;
      padding: 40px 0;
    }
    
    /* ===== IMAGE STYLES ===== */
    #shopify-section-{{ section.id }} .image-with-text-section-inner-image {
      position: relative;
      overflow: hidden;
      border-radius: {{ section.settings.image_border_radius | default: 20 }}px;
      height: {{ section.settings.image_height | default: 400 }}px;
    }
    
    #shopify-section-{{ section.id }} .image-with-text-section-inner-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.3s ease;
    }
    
    #shopify-section-{{ section.id }} .image-with-text-section-inner-image:hover img {
      transform: scale(1.02);
    }
    
    /* ===== TEXT STYLES ===== */
    #shopify-section-{{ section.id }} .image-with-text-section-inner-text {
      text-align: {{ section.settings.text_alignment | default: 'left' }};
      padding: 20px {{ section.settings.desktop_padding_right | default: 40 }}px 20px {{ section.settings.desktop_padding_left | default: 40 }}px;
      color: {{ section.settings.text_color | default: '#666666' }};
      display: flex;
      flex-direction: column;
      justify-content: center;
      height: 100%;
    }
    
    #shopify-section-{{ section.id }} .image-with-text-section-inner-text-heading {
      font-weight: 700;
      font-size: {{ section.settings.heading_size | default: 2.5 }}rem;
      color: {{ section.settings.heading_color | default: '#1a1a2e' }};
      margin: 0 0 {{ section.settings.heading_bottom_margin | default: 15 }}px 0;
      line-height: 1.3;
      font-family: 'Montserrat', sans-serif;
    }
    
    #shopify-section-{{ section.id }} .image-with-text-section-inner-text-text {
      font-size: 18px;
      line-height: 1.8;
      color: {{ section.settings.text_color | default: '#666666' }};
      font-family: 'Montserrat', sans-serif;
    }
    
    #shopify-section-{{ section.id }} .image-with-text-section-inner-text-text p {
      margin-bottom: 15px;
    }
    
    #shopify-section-{{ section.id }} .image-with-text-section-inner-text-text p:last-child {
      margin-bottom: 0;
    }
    
    /* ===== BUTTON STYLES ===== */
    #shopify-section-{{ section.id }} .image-with-text-section-inner-text .button {
      display: inline-block;
      margin-top: 25px;
      padding: 14px 35px;
      background-color: {{ section.settings.button_bg_color | default: '#0066CC' }};
      color: #ffffff;
      border-radius: 50px;
      text-decoration: none;
      font-weight: 600;
      font-size: 16px;
      transition: all 0.3s ease;
      font-family: 'Montserrat', sans-serif;
      text-align: center;
      align-self: {{ section.settings.text_alignment | default: 'left' }};
      border: 2px solid {{ section.settings.button_bg_color | default: '#0066CC' }};
    }
    
    #shopify-section-{{ section.id }} .image-with-text-section-inner-text .button:hover {
      background-color: transparent;
      color: {{ section.settings.button_bg_color | default: '#0066CC' }};
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }
    
    /* ===== LAYOUT SPECIFIC ===== */
    #shopify-section-{{ section.id }} .image-with-text-section-inner.mod-layout-image-left {
      flex-direction: row;
    }
    
    #shopify-section-{{ section.id }} .image-with-text-section-inner.mod-layout-image-right {
      flex-direction: row-reverse;
    }
    
    /* ===== TABLET RESPONSIVE ===== */
    @media screen and (max-width: 1024px) {
      #shopify-section-{{ section.id }} .image-with-text-section-inner {
        gap: 30px;
        padding: 0 20px;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner .cell {
        padding: 30px 0;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner-text {
        padding: 15px {{ section.settings.tablet_padding_right | default: 30 }}px 15px {{ section.settings.tablet_padding_left | default: 30 }}px;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner-text-heading {
        font-size: {{ section.settings.tablet_heading_size | default: 2.2 }}rem;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner-image {
        height: {{ section.settings.tablet_image_height | default: 350 }}px;
      }
    }
    
    /* ===== MOBILE RESPONSIVE ===== */
    @media screen and (max-width: 768px) {
      #shopify-section-{{ section.id }} .image-with-text-section-inner {
        flex-direction: column !important;
        gap: 0;
        padding: 0;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner .cell {
        width: 100% !important;
        padding: 0 !important;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner-image {
        height: {{ section.settings.mobile_image_height | default: 280 }}px;
        border-radius: {{ section.settings.mobile_image_border_radius | default: 15 }}px {{ section.settings.mobile_image_border_radius | default: 15 }}px 0 0;
        width: 100%;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner-image img {
        border-radius: {{ section.settings.mobile_image_border_radius | default: 15 }}px {{ section.settings.mobile_image_border_radius | default: 15 }}px 0 0;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner-text {
        padding: {{ section.settings.mobile_padding_top | default: 25 }}px {{ section.settings.mobile_padding_right | default: 20 }}px {{ section.settings.mobile_padding_bottom | default: 30 }}px {{ section.settings.mobile_padding_left | default: 20 }}px !important;
        text-align: {{ section.settings.mobile_text_alignment | default: 'center' }};
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner-text-heading {
        font-size: {{ section.settings.mobile_heading_size | default: 1.8 }}rem !important;
        margin-bottom: {{ section.settings.mobile_heading_bottom_margin | default: 10 }}px !important;
        text-align: {{ section.settings.mobile_text_alignment | default: 'center' }};
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner-text-text {
        font-size: {{ section.settings.mobile_text_size | default: 16 }}px;
        text-align: {{ section.settings.mobile_text_alignment | default: 'center' }};
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner-text .button {
        font-size: 15px;
        padding: 12px 30px;
        align-self: center;
        width: auto;
        display: inline-block;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner.mod-layout-image-right {
        flex-direction: column !important;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner.mod-layout-image-right .image-with-text-section-inner-image {
        order: -1;
      }
    }
    
    /* ===== SMALL MOBILE ===== */
    @media screen and (max-width: 400px) {
      #shopify-section-{{ section.id }} .image-with-text-section-inner-image {
        height: {{ section.settings.small_mobile_image_height | default: 220 }}px;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner-text {
        padding: 20px {{ section.settings.small_mobile_padding_right | default: 15 }}px 25px {{ section.settings.small_mobile_padding_left | default: 15 }}px !important;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner-text-heading {
        font-size: {{ section.settings.small_mobile_heading_size | default: 1.5 }}rem !important;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner-text-text {
        font-size: 15px;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner-text .button {
        font-size: 14px;
        padding: 10px 25px;
        width: 100%;
        text-align: center;
      }
    }
  </style>

  {% capture image_layout %}
    {% if section.settings.image %}
      {% render 'image', image: section.settings.image %}
    {% else %}
      {% render 'image', image_placeholder: true %}
    {% endif %}
  {% endcapture %}

  <div class="image-with-text-section-inner mod-layout-image-{{ section.settings.layout | default: 'left' }}">

    {% if section.settings.layout == 'left' %}
      <div class="image-with-text-section-inner-image cell">
        {{ image_layout }}
      </div>
    {% endif %}

    <div class="image-with-text-section-inner-text cell">

      {% unless section.settings.heading == blank %}
        <h2 class="image-with-text-section-inner-text-heading lhxt">
          {{ section.settings.heading | escape }}
        </h2>
      {% endunless %}

      {% unless section.settings.text == blank %}
        <div class="image-with-text-section-inner-text-text">{{ section.settings.text }}</div>
      {% endunless %}

      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="button">
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}
      
    </div>

    {% if section.settings.layout == 'right' %}
      <div class="image-with-text-section-inner-image cell">
        {{ image_layout }}
      </div>
    {% endif %}

  </div>

{% render 'section-close' %}


