{% comment %}
  FAQ Section - Customizable accordion-style FAQ with schema settings
{% endcomment %}

<div class="faq-section" id="shopify-section-{{ section.id }}">
  <div class="faq-container">
    
    <!-- Section Heading -->
    {% if section.settings.heading != blank %}
      <div class="faq-header">
        <h2 class="faq-heading">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="faq-subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <!-- FAQ Items -->
    <div class="faq-items">
      {% for block in section.blocks %}
        <div class="faq-item" 
             itemscope 
             itemprop="mainEntity" 
             itemtype="https://schema.org/Question">
          
          <button class="faq-question" 
                  aria-expanded="{% if forloop.first == true and section.settings.expand_first %}true{% else %}false{% endif %}"
                  id="faq-question-{{ block.id }}">
            <span itemprop="name">{{ block.settings.question }}</span>
            <span class="faq-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
              </svg>
            </span>
          </button>
          
          <div class="faq-answer" 
               role="region" 
               aria-labelledby="faq-question-{{ block.id }}"
               itemscope 
               itemprop="acceptedAnswer" 
               itemtype="https://schema.org/Answer"
               {% if forloop.first == true and section.settings.expand_first %}style="display: block;"{% endif %}>
            <div itemprop="text" class="faq-answer-content">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</div>

<style>
  /* ===== FAQ Section Styles ===== */
  #shopify-section-{{ section.id }} .faq-section {
    padding: {{ section.settings.section_padding }}px 0;
    background-color: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .faq-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* ===== Header Styles ===== */
  #shopify-section-{{ section.id }} .faq-header {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: {{ section.settings.heading_spacing }}px;
  }

  #shopify-section-{{ section.id }} .faq-heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0 0 10px 0;
  }

  #shopify-section-{{ section.id }} .faq-subheading {
    font-size: {{ section.settings.subheading_size }}px;
    color: {{ section.settings.subheading_color }};
    margin: 0;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ===== FAQ Item Styles ===== */
  #shopify-section-{{ section.id }} .faq-items {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.item_gap }}px;
  }

  #shopify-section-{{ section.id }} .faq-item {
    border: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
    border-radius: {{ section.settings.border_radius }}px;
    overflow: hidden;
    background-color: {{ section.settings.item_background }};
    transition: all 0.3s ease;
  }

  #shopify-section-{{ section.id }} .faq-item:hover {
    border-color: {{ section.settings.border_hover_color }};
  }

  /* ===== Question Styles ===== */
  #shopify-section-{{ section.id }} .faq-question {
    width: 100%;
    padding: {{ section.settings.question_padding }}px;
    background: none;
    border: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-size: {{ section.settings.question_size }}px;
    font-weight: {{ section.settings.question_weight }};
    color: {{ section.settings.question_color }};
    text-align: left;
    transition: all 0.3s ease;
    font-family: inherit;
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .faq-question:hover {
    color: {{ section.settings.question_hover_color }};
  }

  #shopify-section-{{ section.id }} .faq-question span:first-child {
    flex: 1;
  }

  /* ===== Icon Styles ===== */
  #shopify-section-{{ section.id }} .faq-icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    color: {{ section.settings.icon_color }};
  }

  #shopify-section-{{ section.id }} .faq-item.active .faq-icon {
    transform: rotate(45deg);
  }

  /* ===== Answer Styles ===== */
  #shopify-section-{{ section.id }} .faq-answer {
    display: none;
    padding: 0 {{ section.settings.question_padding }}px {{ section.settings.answer_padding }}px;
    background-color: {{ section.settings.answer_background }};
  }

  #shopify-section-{{ section.id }} .faq-answer.active {
    display: block;
  }

  #shopify-section-{{ section.id }} .faq-answer-content {
    font-size: {{ section.settings.answer_size }}px;
    color: {{ section.settings.answer_color }};
    line-height: 1.7;
    padding-top: {{ section.settings.answer_top_padding }}px;
    border-top: {{ section.settings.answer_border_width }}px solid {{ section.settings.answer_border_color }};
  }

  #shopify-section-{{ section.id }} .faq-answer-content p {
    margin: 0 0 15px 0;
  }

  #shopify-section-{{ section.id }} .faq-answer-content p:last-child {
    margin-bottom: 0;
  }

  /* ===== Mobile Responsive ===== */
  @media screen and (max-width: 640px) {
    #shopify-section-{{ section.id }} .faq-section {
      padding: {{ section.settings.mobile_section_padding }}px 0;
    }

    #shopify-section-{{ section.id }} .faq-heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #shopify-section-{{ section.id }} .faq-subheading {
      font-size: {{ section.settings.mobile_subheading_size }}px;
    }

    #shopify-section-{{ section.id }} .faq-question {
      font-size: {{ section.settings.mobile_question_size }}px;
      padding: {{ section.settings.mobile_question_padding }}px;
    }

    #shopify-section-{{ section.id }} .faq-answer-content {
      font-size: {{ section.settings.mobile_answer_size }}px;
      padding-top: {{ section.settings.mobile_answer_top_padding }}px;
    }

    #shopify-section-{{ section.id }} .faq-answer {
      padding: 0 {{ section.settings.mobile_question_padding }}px {{ section.settings.mobile_answer_padding }}px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const faqItems = document.querySelectorAll('#shopify-section-{{ section.id }} .faq-item');
    
    faqItems.forEach((item) => {
      const question = item.querySelector('.faq-question');
      const answer = item.querySelector('.faq-answer');
      
      question.addEventListener('click', function() {
        const isActive = item.classList.contains('active');
        
        // Close all items if accordion mode is enabled
        {% if section.settings.accordion_mode %}
          faqItems.forEach((otherItem) => {
            if (otherItem !== item && otherItem.classList.contains('active')) {
              otherItem.classList.remove('active');
              otherItem.querySelector('.faq-answer').style.display = 'none';
              otherItem.querySelector('.faq-question').setAttribute('aria-expanded', 'false');
            }
          });
        {% endif %}
        
        // Toggle current item
        if (isActive) {
          item.classList.remove('active');
          answer.style.display = 'none';
          question.setAttribute('aria-expanded', 'false');
        } else {
          item.classList.add('active');
          answer.style.display = 'block';
          question.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>

