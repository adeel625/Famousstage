{% if product %}
  <div class="product-tabs-section" data-section-id="{{ section.id }}" data-section-type="product-tabs">
    <div class="page-width">
      
      <div class="tabs-wrapper">
        <ul class="tabs-nav" role="tablist">
          <li class="tab-item active" role="tab" data-tab="additional-info">
            {{ section.settings.tab_1_label | default: 'Additional Information' }}
          </li>
          <li class="tab-item" role="tab" data-tab="faq">
            {{ section.settings.tab_2_label | default: 'Frequently Asked Questions' }}
          </li>
        </ul>
        
        <div class="tabs-content">
          
          <!-- ========================================== -->
          <!-- TAB 1: ADDITIONAL INFORMATION               -->
          <!-- ========================================== -->
          <div class="tab-panel active" id="additional-info" role="tabpanel">
            <div class="additional-info-content">
              
              <div class="info-block metafields-block">
                <h3 class="info-title">{{ section.settings.metafields_title | default: 'Product Details' }}</h3>
                <div class="metafields-grid">
                  
                  {% assign has_metafields = false %}
                  
                  <!-- ======================================== -->
                  <!-- LOOP THROUGH ALL METAFIELDS              -->
                  <!-- ======================================== -->
                  {% for field in product.metafields.custom %}
                    {% assign field_key = field[0] %}
                    {% assign field_value = field[1] %}
                    
                    <!-- Skip FAQ field (it goes to FAQ tab) -->
                    {% if field_key == 'faq' %}
                      {% continue %}
                    {% endif %}
                    
                    {% if field_value != blank %}
                      {% assign has_metafields = true %}
                      <div class="metafield-item">
                        <span class="metafield-label">{{ field_key | replace: '_', ' ' | capitalize }}:</span>
                        <span class="metafield-value">
                          {% if field_value.type == 'file_reference' %}
                            <a href="{{ field_value.value }}" target="_blank">📄 View File</a>
                          {% elsif field_value.type == 'url' %}
                            <a href="{{ field_value.value }}" target="_blank">{{ field_value.value }}</a>
                          {% elsif field_value.type == 'json' %}
                            {% comment %} Extract text from Shopify rich text JSON {% endcomment %}
                            {% assign json_data = field_value.value %}
                            {% if json_data contains 'children' %}
                              {% assign text_parts = json_data | split: '"value"=>"' %}
                              {% for part in text_parts %}
                                {% if forloop.first %}{% continue %}{% endif %}
                                {% assign text = part | split: '"' | first %}
                                {{ text }}
                              {% endfor %}
                            {% else %}
                              {{ json_data }}
                            {% endif %}
                          {% elsif field_value.type == 'boolean' %}
                            {% if field_value.value == true %}Yes{% else %}No{% endif %}
                          {% elsif field_value.type == 'date' %}
                            {{ field_value.value | date: "%B %d, %Y" }}
                          {% elsif field_value.type == 'number' %}
                            {{ field_value.value }}
                          {% elsif field_value.type == 'string' %}
                            {{ field_value.value }}
                          {% else %}
                            {{ field_value.value }}
                          {% endif %}
                        </span>
                      </div>
                      <hr class="metafield-divider">
                    {% endif %}
                  {% endfor %}
                  
                  <!-- ======================================== -->
                  <!-- FALLBACK: Product Description           -->
                  <!-- ======================================== -->
                  {% unless has_metafields %}
                    <div class="metafield-item">
                      <span class="metafield-label">Description:</span>
                      <span class="metafield-value">{{ product.description }}</span>
                    </div>
                  {% endunless %}
                  
                </div>
              </div>
              
            </div>
          </div>
          
          <!-- ========================================== -->
          <!-- TAB 2: FAQ (MetaobjectListDrop)            -->
          <!-- ========================================== -->
          <div class="tab-panel" id="faq" role="tabpanel">
            <div class="faq-content">
              
              {% assign has_faq = false %}
              
              <!-- ======================================== -->
              <!-- GET FAQ FROM METAFIELD                   -->
              <!-- ======================================== -->
              {% assign faq_metafield = product.metafields.custom.faq %}
              
              {% if faq_metafield != blank %}
                {% assign has_faq = true %}
                <div class="faq-list">
                  
                  {% comment %}
                    Shopify MetaobjectListDrop ka structure:
                    faq_metafield.value gives an array of metaobjects
                    Each entry has fields like: question, answer, title, name, etc.
                  {% endcomment %}
                  
                  {% for entry in faq_metafield.value %}
                    <div class="faq-item">
                      <div class="faq-question" data-toggle="collapse">
                        <span>
                          {% if entry.question %}
                            {{ entry.question }}
                          {% elsif entry.title %}
                            {{ entry.title }}
                          {% elsif entry.name %}
                            {{ entry.name }}
                          {% else %}
                            Question {{ forloop.index }}
                          {% endif %}
                        </span>
                        <span class="faq-toggle">+</span>
                      </div>
                      <div class="faq-answer" style="display: none;">
                        {% if entry.answer %}
                          {{ entry.answer }}
                        {% elsif entry.content %}
                          {{ entry.content }}
                        {% elsif entry.description %}
                          {{ entry.description }}
                        {% else %}
                          No answer provided.
                        {% endif %}
                      </div>
                    </div>
                  {% endfor %}
                  
                </div>
              {% endif %}
              
              <!-- ======================================== -->
              <!-- FALLBACK: No FAQ found                  -->
              <!-- ======================================== -->
              {% unless has_faq %}
                <p class="faq-placeholder">{{ section.settings.empty_faq_message | default: 'No FAQ items found for this product.' }}</p>
              {% endunless %}
              
            </div>
          </div>
          
        </div>
      </div>
    </div>
  </div>

  <style>
    .product-tabs-section {
      margin: 40px 0;
      padding: 0 20px;
    }
    .product-tabs-section .page-width {
      max-width: 1200px;
      margin: 0 auto;
    }
    
    .tabs-nav {
      display: flex;
      list-style: none;
      padding: 0;
      margin: 0 0 20px 0;
      border-bottom: 2px solid #eaeaea;
      flex-wrap: wrap;
    }
    .tab-item {
      padding: 14px 28px;
      cursor: pointer;
      font-weight: 700;
      font-size: 20px;
      color: #888;
      border-bottom: 3px solid transparent;
      margin-bottom: -2px;
      transition: all 0.3s ease;
      user-select: none;
    }
    .tab-item.active {
      color: #000;
      border-bottom-color: #000;
    }
    .tab-item:hover {
      color: #000;
    }
    
    .tab-panel {
      display: none;
      padding: 20px 0;
      animation: fadeIn 0.3s ease;
    }
    .tab-panel.active {
      display: block;
    }
    
    .additional-info-content .info-block {
      margin-bottom: 25px;
    }
    .additional-info-content .info-title {
      font-size: 22px;
      font-weight: 600;
      margin-bottom: 20px;
      color: #000;
    }
    
    .metafields-grid {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .metafield-item {
      display: flex;
      padding: 12px 0;
      align-items: flex-start;
    }
    .metafield-label {
      font-weight: 600;
      min-width: 200px;
      color: #000;
      font-size: 16px;
    }
    .metafield-value {
      color: #333;
      flex: 1;
      font-size: 16px;
      line-height: 1.6;
    }
    .metafield-value img {
      max-width: 150px;
      height: auto;
      border-radius: 4px;
      border: 1px solid #eaeaea;
    }
    
    .metafield-divider {
      border: none;
      border-top: 1px solid #eaeaea;
      margin: 0;
      height: 0;
    }
    
    .faq-item {
      border-bottom: 1px solid #eaeaea;
      padding: 16px 0;
    }
    .faq-item:last-child {
      border-bottom: none;
    }
    .faq-question {
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      font-weight: 600;
      font-size: 17px;
      padding: 4px 0;
      color: #000;
    }
    .faq-question:hover {
      color: #333;
    }
    .faq-question .faq-toggle {
      font-size: 26px;
      font-weight: 300;
      transition: transform 0.3s ease;
      color: #888;
      line-height: 1;
    }
    .faq-question.active .faq-toggle {
      transform: rotate(45deg);
      color: #000;
    }
    .faq-answer {
      padding-top: 16px;
      color: #555;
      line-height: 1.8;
      font-size: 16px;
    }
    .faq-answer p {
      margin: 5px 0;
    }
    
    .faq-placeholder {
      color: #999;
      font-style: italic;
      padding: 20px 0;
      text-align: center;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    @media (max-width: 768px) {
      .tab-item {
        padding: 12px 18px;
        font-size: 16px;
        flex: 1;
        text-align: center;
      }
      .product-tabs-section {
        margin: 20px 0;
        padding: 0 12px;
      }
      .faq-question {
        font-size: 15px;
      }
      .additional-info-content .info-title {
        font-size: 18px;
      }
      .metafield-item {
        flex-direction: column;
        padding: 10px 0;
      }
      .metafield-label {
        min-width: auto;
        margin-bottom: 4px;
        font-size: 14px;
      }
      .metafield-value {
        font-size: 14px;
      }
    }
  </style>

  <script>
    (function() {
      const sectionId = {{ section.id | json }};
      const container = document.querySelector(`[data-section-id="${sectionId}"]`);
      if (!container) return;
      
      // Tab switching
      const tabs = container.querySelectorAll('.tab-item');
      const panels = container.querySelectorAll('.tab-panel');
      
      tabs.forEach(tab => {
        tab.addEventListener('click', function() {
          tabs.forEach(t => t.classList.remove('active'));
          this.classList.add('active');
          
          const tabId = this.dataset.tab;
          panels.forEach(panel => {
            panel.classList.toggle('active', panel.id === tabId);
          });
        });
      });
      
      // FAQ toggle
      const faqQuestions = container.querySelectorAll('.faq-question');
      faqQuestions.forEach(question => {
        question.addEventListener('click', function() {
          this.classList.toggle('active');
          const answer = this.nextElementSibling;
          if (answer && answer.classList.contains('faq-answer')) {
            if (answer.style.display === 'none' || answer.style.display === '') {
              answer.style.display = 'block';
            } else {
              answer.style.display = 'none';
            }
          }
        });
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Product Dynamic Tabs",
  "class": "shopify-section-product-tabs",
  "settings": [
    {
      "type": "header",
      "content": "📑 Tab Labels"
    },
    {
      "type": "text",
      "id": "tab_1_label",
      "label": "Additional Information Tab Label",
      "default": "Additional Information"
    },
    {
      "type": "text",
      "id": "tab_2_label",
      "label": "FAQ Tab Label",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "header",
      "content": "📋 Additional Information (Metafields)"
    },
    {
      "type": "text",
      "id": "metafields_title",
      "label": "Section Title",
      "default": "Product Details"
    },
    {
      "type": "text",
      "id": "empty_faq_message",
      "label": "Empty FAQ Message",
      "default": "No FAQ items found for this product."
    }
  ],
  "presets": [
    {
      "name": "Product Dynamic Tabs",
      "category": "Product",
      "settings": {
        "tab_1_label": "Additional Information",
        "tab_2_label": "Frequently Asked Questions"
      }
    }
  ]
}
{% endschema %}