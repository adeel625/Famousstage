{% comment %}
  Testimonials Section - 3 Column Grid
  No carousel, static grid layout with author images
{% endcomment %}

<div class="testimonials-section" id="shopify-section-{{ section.id }}">
  <div class="testimonials-container">
    
    <!-- Section Heading -->
    {% if section.settings.heading != blank %}
      <div class="testimonials-header">
        <h2 class="testimonials-heading">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="testimonials-subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <!-- Testimonials Grid - 3 Columns -->
    <div class="testimonials-grid">
      {% for block in section.blocks %}
        <div class="testimonial-card" 
             itemscope 
             itemprop="review" 
             itemtype="https://schema.org/Review">
          
          <div class="testimonial-card-inner">
            
            <!-- Stars Rating -->
            {% if section.settings.show_stars %}
              <div class="testimonial-stars">
                {% assign rating = block.settings.rating | default: 5 %}
                {% for i in (1..5) %}
                  {% if i <= rating %}
                    <span class="star filled">★</span>
                  {% else %}
                    <span class="star empty">★</span>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
            
            <!-- Testimonial Text -->
            <div class="testimonial-text" itemprop="reviewBody">
              {{ block.settings.testimonial }}
            </div>
            
            <!-- Author Info with Image -->
            <div class="testimonial-author">
              {% if block.settings.author_image != blank %}
                <div class="author-image">
                  <img src="{{ block.settings.author_image | img_url: '100x100', crop: 'center' }}" 
                       alt="{{ block.settings.author_name }}" 
                       loading="lazy"
                       width="60" 
                       height="60">
                </div>
              {% else %}
                <!-- Fallback placeholder if no image -->
                <div class="author-image-placeholder">
                  <span>{{ block.settings.author_name | slice: 0 | upcase }}</span>
                </div>
              {% endif %}
              <div class="author-info">
                <div class="author-name" itemprop="author">{{ block.settings.author_name }}</div>
                <div class="author-title">{{ block.settings.author_title }}</div>
              </div>
            </div>
            
            <!-- Category/Tag -->
            {% if block.settings.category != blank %}
              <div class="testimonial-category">{{ block.settings.category }}</div>
            {% endif %}
            
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</div>

<style>
  /* ===== Testimonials Section Styles ===== */
  #shopify-section-{{ section.id }} .testimonials-section {
    padding: {{ section.settings.section_padding }}px 0;
    background-color: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .testimonials-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* ===== Header Styles ===== */
  #shopify-section-{{ section.id }} .testimonials-header {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: {{ section.settings.heading_spacing }}px;
  }

  #shopify-section-{{ section.id }} .testimonials-heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0 0 10px 0;
  }

  #shopify-section-{{ section.id }} .testimonials-subheading {
    font-size: {{ section.settings.subheading_size }}px;
    color: {{ section.settings.subheading_color }};
    margin: 0;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  /* ===== Testimonials Grid - 3 Columns ===== */
  #shopify-section-{{ section.id }} .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ section.settings.card_gap }}px;
  }

  /* ===== Testimonial Card Styles ===== */
  #shopify-section-{{ section.id }} .testimonial-card {
    background: {{ section.settings.card_background }};
    border-radius: {{ section.settings.card_border_radius }}px;
    padding: {{ section.settings.card_padding }}px;
    box-shadow: {{ section.settings.card_shadow_horizontal }}px {{ section.settings.card_shadow_vertical }}px {{ section.settings.card_shadow_blur }}px rgba(0,0,0,{{ section.settings.card_shadow_opacity }});
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .testimonial-card:hover {
    transform: translateY(-4px);
    box-shadow: {{ section.settings.card_shadow_horizontal }}px {{ section.settings.card_shadow_vertical_hover }}px {{ section.settings.card_shadow_blur_hover }}px rgba(0,0,0,{{ section.settings.card_shadow_opacity_hover }});
    border-color: {{ section.settings.card_border_hover_color }};
  }

  #shopify-section-{{ section.id }} .testimonial-card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* ===== Stars ===== */
  #shopify-section-{{ section.id }} .testimonial-stars {
    margin-bottom: {{ section.settings.star_margin }}px;
    display: flex;
    gap: 4px;
  }

  #shopify-section-{{ section.id }} .testimonial-stars .star {
    font-size: {{ section.settings.star_size }}px;
    color: {{ section.settings.star_color_empty }};
  }

  #shopify-section-{{ section.id }} .testimonial-stars .star.filled {
    color: {{ section.settings.star_color_filled }};
  }

  /* ===== Testimonial Text ===== */
  #shopify-section-{{ section.id }} .testimonial-text {
    flex: 1;
    font-size: {{ section.settings.text_size }}px;
    line-height: {{ section.settings.text_line_height }};
    color: {{ section.settings.text_color }};
    margin-bottom: {{ section.settings.text_margin }}px;
    font-style: {{ section.settings.text_style }};
  }

  #shopify-section-{{ section.id }} .testimonial-text p {
    margin: 0;
  }

  /* ===== Author Section with Image ===== */
  #shopify-section-{{ section.id }} .testimonial-author {
    display: flex;
    align-items: center;
    gap: {{ section.settings.author_gap }}px;
    margin-top: auto;
    padding-top: {{ section.settings.author_padding_top }}px;
    border-top: {{ section.settings.divider_width }}px solid {{ section.settings.divider_color }};
  }

  #shopify-section-{{ section.id }} .author-image {
    flex-shrink: 0;
    width: {{ section.settings.author_image_size }}px;
    height: {{ section.settings.author_image_size }}px;
    border-radius: 50%;
    overflow: hidden;
    border: {{ section.settings.author_image_border_width }}px solid {{ section.settings.author_image_border_color }};
  }

  #shopify-section-{{ section.id }} .author-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ===== Author Image Placeholder ===== */
  #shopify-section-{{ section.id }} .author-image-placeholder {
    flex-shrink: 0;
    width: {{ section.settings.author_image_size }}px;
    height: {{ section.settings.author_image_size }}px;
    border-radius: 50%;
    background: {{ section.settings.author_image_border_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    font-weight: 700;
    color: #ffffff;
    border: {{ section.settings.author_image_border_width }}px solid {{ section.settings.author_image_border_color }};
  }

  #shopify-section-{{ section.id }} .author-info {
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .author-name {
    font-size: {{ section.settings.author_name_size }}px;
    font-weight: {{ section.settings.author_name_weight }};
    color: {{ section.settings.author_name_color }};
    margin: 0;
  }

  #shopify-section-{{ section.id }} .author-title {
    font-size: {{ section.settings.author_title_size }}px;
    color: {{ section.settings.author_title_color }};
    margin: 0;
  }

  /* ===== Category/Tag ===== */
  #shopify-section-{{ section.id }} .testimonial-category {
    display: inline-block;
    margin-top: {{ section.settings.category_margin }}px;
    font-size: {{ section.settings.category_size }}px;
    font-weight: {{ section.settings.category_weight }};
    color: {{ section.settings.category_color }};
    background: {{ section.settings.category_background }};
    padding: 4px 12px;
    border-radius: {{ section.settings.category_border_radius }}px;
    align-self: flex-start;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  /* ===== Tablet Responsive ===== */
  @media screen and (max-width: 1024px) {
    #shopify-section-{{ section.id }} .testimonials-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  /* ===== Mobile Responsive ===== */
  @media screen and (max-width: 640px) {
    #shopify-section-{{ section.id }} .testimonials-section {
      padding: {{ section.settings.mobile_section_padding }}px 0;
    }

    #shopify-section-{{ section.id }} .testimonials-container {
      padding: 0 15px;
    }

    #shopify-section-{{ section.id }} .testimonials-grid {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    #shopify-section-{{ section.id }} .testimonials-heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #shopify-section-{{ section.id }} .testimonials-subheading {
      font-size: {{ section.settings.mobile_subheading_size }}px;
    }

    #shopify-section-{{ section.id }} .testimonial-card {
      padding: {{ section.settings.mobile_card_padding }}px;
    }

    #shopify-section-{{ section.id }} .testimonial-text {
      font-size: {{ section.settings.mobile_text_size }}px;
    }

    #shopify-section-{{ section.id }} .author-image,
    #shopify-section-{{ section.id }} .author-image-placeholder {
      width: {{ section.settings.mobile_author_image_size }}px;
      height: {{ section.settings.mobile_author_image_size }}px;
    }

    #shopify-section-{{ section.id }} .author-image-placeholder {
      font-size: 18px;
    }

    #shopify-section-{{ section.id }} .author-name {
      font-size: {{ section.settings.mobile_author_name_size }}px;
    }

    #shopify-section-{{ section.id }} .author-title {
      font-size: {{ section.settings.mobile_author_title_size }}px;
    }

    #shopify-section-{{ section.id }} .testimonial-stars .star {
      font-size: {{ section.settings.mobile_star_size }}px;
    }

    #shopify-section-{{ section.id }} .testimonial-category {
      font-size: {{ section.settings.mobile_category_size }}px;
      padding: 4px 12px;
    }
  }

  /* ===== Small Mobile ===== */
  @media screen and (max-width: 400px) {
    #shopify-section-{{ section.id }} .testimonials-section {
      padding: 30px 0;
    }

    #shopify-section-{{ section.id }} .testimonial-card {
      padding: 16px;
    }

    #shopify-section-{{ section.id }} .testimonials-heading {
      font-size: 22px;
    }

    #shopify-section-{{ section.id }} .testimonials-subheading {
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .testimonial-text {
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .author-image,
    #shopify-section-{{ section.id }} .author-image-placeholder {
      width: 40px;
      height: 40px;
    }

    #shopify-section-{{ section.id }} .author-image-placeholder {
      font-size: 14px;
    }
  }
</style>

{% schema %}
