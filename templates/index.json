    "faq_section_3gc68a": {
      "type": "faq-section",
      "blocks": {
        "faq_item_XEqnqN": {
          "type": "faq_item",
          "settings": {
            "question": "What's the difference between box truss and triangle truss?",
            "answer": "<p>Box truss (F34) is a 4-point system built for balanced, heavier loads the standard choice for stages and trade show booths. Triangle truss (F33) is a lighter 3-point system, easier to handle, and common for DJ booths and smaller arches where weight is the priority over maximum load.<br/><br/></p>"
          }
        },
        "faq_item_WN6CDr": {
          "type": "faq_item",
          "settings": {
            "question": "Is the box truss TUV-certified?",
            "answer": "<p>Yes the Global Truss box truss sections sold by Famous Stages are listed as TUV-certified, meaning they've been independently tested against a recognized structural safety standard for load-bearing truss.<br/><br/></p>"
          }
        },
        "faq_item_7YCYjH": {
          "type": "faq_item",
          "settings": {
            "question": "How much does shipping cost on a Global Truss order?",
            "answer": "<p>Freight on Global Truss orders is currently capped at $499 maximum, with delivery available anywhere in the continental United States.<br/><br/></p>"
          }
        },
        "faq_item_aXP9Ax": {
          "type": "faq_item",
          "settings": {
            "question": "Does Famous Stages offer financing?",
            "answer": "<p>Yes. Payment plans are available on truss, staging, and video wall packages so the full cost doesn't have to be paid upfront.<br/><br/></p>"
          }
        },
        "faq_item_hiUpBb": {
          "type": "faq_item",
          "settings": {
            "question": "Does Famous Stages rent equipment or only sell it?",
            "answer": "<p> Famous Stages primarily sells truss, staging, and video wall equipment. Rentals are handled separately through Famous Stages Houston, for customers who need short-term or event-specific gear instead of a purchase<br/><br/></p>"
          }
        },
        "faq_item_NEEXbz": {
          "type": "faq_item",
          "settings": {
            "question": "What size box truss do I need?",
            "answer": "<p>Global Truss box truss (F34): The most popular 4 point system for stages, booths and lighting rigs. Lighter 3 point system, suitable for smaller spans where weight is more important than maximum load, such as a DJ booth or goal-post arches (F33). Actual load capacity varies based on the span length and support spacing that a rep can configure a run to your specific footprint.<br/><br/></p>"
          }
        }
      },
