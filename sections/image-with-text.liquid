{% render 'section-open', section: section, type: 'image-with-text', title: false %}

  <style>
    #shopify-section-{{ section.id }} .image-with-text-section-inner .cell {
      width: 50%;
      padding-top: 50px;
      padding-bottom: 50px;
    }
    
    #shopify-section-{{ section.id }} .image-with-text-section-inner-text {
      text-align: {{ section.settings.text_alignment }};
      font-size: 18px;
      padding-left: {{ section.settings.desktop_padding_left }}px;
      padding-right: {{ section.settings.desktop_padding_right }}px;
      color:#666666;
    }
    
    #shopify-section-{{ section.id }} .image-with-text-section-inner-text-text > *:last-child {
      margin-bottom: 0;
    }
    
    #shopify-section-{{ section.id }} .image-with-text-section-inner-text-heading {
      font-weight: 700;
      font-size: {{ section.settings.heading_size }}rem;
      color: {{ section.settings.color_text }};
      {% if section.settings.heading != blank and section.settings.text == blank %}
        margin: 0;
      {% else %}
        margin-top: 0;
        margin-bottom: {{ section.settings.heading_bottom_margin }}px;
      {% endif %}
    }
    
    #shopify-section-{{ section.id }} .image-with-text-section-inner.mod-layout-image-left .image-with-text-section-inner-text {
      padding-left: {{ section.settings.desktop_padding_left }}px;
    }
    
    #shopify-section-{{ section.id }} .image-with-text-section-inner.mod-layout-image-right .image-with-text-section-inner-text {
      padding-right: {{ section.settings.desktop_padding_right }}px;
    }
    
    #shopify-section-{{ section.id }} .image-with-text-section-inner-image img {
      border-radius: {{ section.settings.image_border_radius }}px;
      overflow: hidden;
    }
    
    /* ===== Desktop Responsive ===== */
    @media screen and (max-width: 1024px) {
      #shopify-section-{{ section.id }} .image-with-text-section-inner-text {
        padding-left: {{ section.settings.tablet_padding_left }}px;
        padding-right: {{ section.settings.tablet_padding_right }}px;

      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner.mod-layout-image-left .image-with-text-section-inner-text {
        padding-left: {{ section.settings.tablet_padding_left }}px;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner.mod-layout-image-right .image-with-text-section-inner-text {
        padding-right: {{ section.settings.tablet_padding_right }}px;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner-text-heading {
        font-size: {{ section.settings.tablet_heading_size }}rem;
      }
    }
    
    /* ===== Mobile Responsive ===== */
    @media screen and (max-width: 640px) {
      #shopify-section-{{ section.id }} .image-with-text-section-inner {
        {% if section.settings.image_first and section.settings.layout == 'right' %}
          display: flex;
          flex-direction: column-reverse;
        {% endif %}
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner .cell {
        display: block;
        width: auto;
        height: auto;
        padding-top: {{ section.settings.mobile_padding_top }}px;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
        {% if section.settings.image_first and section.settings.layout == 'right' %}
          padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
        {% endif %}
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner-text {
        padding-left: {{ section.settings.mobile_padding_left }}px !important;
        padding-right: {{ section.settings.mobile_padding_right }}px !important;
        font-size: {{ section.settings.mobile_text_size }}px;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner.mod-layout-image-left .image-with-text-section-inner-text {
        padding: {{ section.settings.mobile_padding_top_mobile }}px {{ section.settings.mobile_padding_right }}px {{ section.settings.mobile_padding_bottom }}px {{ section.settings.mobile_padding_left }}px !important;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner.mod-layout-image-right .image-with-text-section-inner-text {
        padding: {{ section.settings.mobile_padding_top_mobile }}px {{ section.settings.mobile_padding_right }}px {{ section.settings.mobile_padding_bottom }}px {{ section.settings.mobile_padding_left }}px !important;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner-text-heading {
        font-size: {{ section.settings.mobile_heading_size }}rem !important;
        margin-bottom: {{ section.settings.mobile_heading_bottom_margin }}px !important;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner-image img {
        border-radius: {{ section.settings.mobile_image_border_radius }}px;
      }
    }
    
    /* ===== Small Mobile ===== */
    @media screen and (max-width: 400px) {
      #shopify-section-{{ section.id }} .image-with-text-section-inner-text {
        padding-left: {{ section.settings.small_mobile_padding_left }}px !important;
        padding-right: {{ section.settings.small_mobile_padding_right }}px !important;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner.mod-layout-image-left .image-with-text-section-inner-text {
        padding: {{ section.settings.mobile_padding_top_mobile }}px {{ section.settings.small_mobile_padding_right }}px {{ section.settings.mobile_padding_bottom }}px {{ section.settings.small_mobile_padding_left }}px !important;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner.mod-layout-image-right .image-with-text-section-inner-text {
        padding: {{ section.settings.mobile_padding_top_mobile }}px {{ section.settings.small_mobile_padding_right }}px {{ section.settings.mobile_padding_bottom }}px {{ section.settings.small_mobile_padding_left }}px !important;
      }
      
      #shopify-section-{{ section.id }} .image-with-text-section-inner-text-heading {
        font-size: {{ section.settings.small_mobile_heading_size }}rem !important;
      }
    }
  </style>

  {% capture image_layout %}
    {% if section.settings.image %}
      {% render 'image', image: section.settings.image %}
    {% else %}
      {% render 'image', image_placeholder: true %}
    {% endif %}
  {% endcapture %}

  <div class="image-with-text-section-inner mod-layout-image-{{ section.settings.layout }} table">

    {% if section.settings.layout == 'left' %}
      <div class="image-with-text-section-inner-image cell">
        {{ image_layout }}
      </div>
    {% endif %}

    <div class="image-with-text-section-inner-text cell">

      {% unless section.settings.heading == blank %}
        <h2 class="image-with-text-section-inner-text-heading lhxt">
          {{ section.settings.heading | escape }}
        </h2>
      {% endunless %}

      {% unless section.settings.text == blank %}
        <div class="image-with-text-section-inner-text-text">{{ section.settings.text }}</div>
      {% endunless %}

      {% if section.settings.button_label != blank and section.settings.button_link != blank %}

        {% render 'separator', class: 'margin-top-40 margin-bottom-50' %}

        <a href="{{ section.settings.button_link }}" target="" class="button">
          {{ section.settings.button_label | escape }}
        </a>

      {% endif %}
    </div>

    {% if section.settings.layout == 'right' %}
      <div class="image-with-text-section-inner-image cell">
        {{ image_layout }}
      </div>
    {% endif %}

  </div>

{% render 'section-close' %}


{% schema %}
{
  "name": "Image with Text",
  "class": "index-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "id": "width",
      "type": "select",
      "label": "Section Width",
      "options": [
        {
          "value": "column-max",
          "label": "Column Max"
        },
        {
          "value": "width-100",
          "label": "Full Width"
        }
      ],
      "default": "column-max"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Layout",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Image Left"
        },
        {
          "value": "right",
          "label": "Image Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "image_first",
      "label": "Image First on Mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image with text"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Pair large text with an image to give focus to your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>"
