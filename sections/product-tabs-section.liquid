{% if product %}
  <div class="product-tabs-section" data-section-id="{{ section.id }}" data-section-type="product-tabs">
    <div class="page-width">
      
      <div class="tabs-wrapper">
        <ul class="tabs-nav" role="tablist">
          <li class="tab-item active" role="tab" data-tab="additional-info">
            {{ section.settings.tab_1_label | default: 'Additional Information' }}
          </li>
          <li class="tab-item" role="tab" data-tab="faq">
            {{ section.settings.tab_2_label | default: 'Frequently Asked Questions' }}
          </li>
        </ul>
        
        <div class="tabs-content">
          
          <!-- ========================================== -->
          <!-- TAB 1: ADDITIONAL INFORMATION               -->
          <!-- ========================================== -->
          <div class="tab-panel active" id="additional-info" role="tabpanel">
            <div class="additional-info-content">
              
              <!-- DYNAMIC METAFIELDS from Product -->
              <div class="info-block metafields-block">
                <h3 class="info-title">{{ section.settings.metafields_title | default: 'Product Details' }}</h3>
                <div class="metafields-grid">
                  
                  {% assign metafield_namespace = section.settings.metafield_namespace | default: 'custom' %}
                  
                  <!-- Get metafield keys from settings -->
                  {% assign metafield_keys_string = section.settings.metafield_keys | strip %}
                  {% assign metafield_keys = metafield_keys_string | split: ',' %}
                  {% assign has_metafields = false %}
                  
                  <!-- Check if specific keys are provided -->
                  {% if metafield_keys_string != blank %}
                    {% for key in metafield_keys %}
                      {% assign trimmed_key = key | strip %}
                      {% if trimmed_key != blank %}
                        {% assign metafield_value = product.metafields[metafield_namespace][trimmed_key] %}
                        
                        {% if metafield_value != blank %}
                          {% assign has_metafields = true %}
                          <div class="metafield-item">
                            <span class="metafield-label">{{ trimmed_key | replace: '_', ' ' | capitalize }}:</span>
                            <span class="metafield-value">
                              {% if metafield_value.type == 'file_reference' %}
                                {% if metafield_value.value contains '.jpg' or metafield_value.value contains '.png' or metafield_value.value contains '.gif' or metafield_value.value contains '.jpeg' or metafield_value.value contains '.webp' %}
                                  <img src="{{ metafield_value.value | img_url: '200x' }}" alt="{{ trimmed_key }}" style="max-width: 150px; height: auto;">
                                {% else %}
                                  <a href="{{ metafield_value.value }}" target="_blank">📄 Download File</a>
                                {% endif %}
                              {% elsif metafield_value.type == 'url' %}
                                <a href="{{ metafield_value.value }}" target="_blank">{{ metafield_value.value }}</a>
                              {% elsif metafield_value.type == 'json' %}
                                {% if metafield_value.value %}
                                  <ul class="metafield-json-list">
                                    {% for item in metafield_value.value %}
                                      <li>
                                        {% for field in item %}
                                          <strong>{{ field[0] | replace: '_', ' ' | capitalize }}:</strong> {{ field[1] }}
                                          {% unless forloop.last %}<br>{% endunless %}
                                        {% endfor %}
                                      </li>
                                    {% endfor %}
                                  </ul>
                                {% endif %}
                              {% elsif metafield_value.type == 'boolean' %}
                                {% if metafield_value.value == true %}Yes{% else %}No{% endif %}
                              {% elsif metafield_value.type == 'number' %}
                                {{ metafield_value.value }}
                              {% elsif metafield_value.type == 'date' %}
                                {{ metafield_value.value | date: "%B %d, %Y" }}
                              {% else %}
                                {{ metafield_value.value }}
                              {% endif %}
                            </span>
                          </div>
                          <hr class="metafield-divider">
                        {% endif %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                  
                  <!-- Auto-detect all metafields if no specific keys provided -->
                  {% if metafield_keys_string == blank %}
                    {% assign all_metafields = product.metafields[metafield_namespace] %}
                    {% if all_metafields.size > 0 %}
                      {% for field in all_metafields %}
                        {% assign has_metafields = true %}
                        <div class="metafield-item">
                          <span class="metafield-label">{{ field[0] | replace: '_', ' ' | capitalize }}:</span>
                          <span class="metafield-value">
                            {% if field[1].type == 'file_reference' %}
                              <a href="{{ field[1].value }}" target="_blank">📄 View File</a>
                            {% elsif field[1].type == 'url' %}
                              <a href="{{ field[1].value }}" target="_blank">{{ field[1].value }}</a>
                            {% elsif field[1].type == 'json' %}
                              {{ field[1].value | json }}
                            {% elsif field[1].type == 'boolean' %}
                              {% if field[1].value == true %}Yes{% else %}No{% endif %}
                            {% elsif field[1].type == 'date' %}
                              {{ field[1].value | date: "%B %d, %Y" }}
                            {% else %}
                              {{ field[1].value }}
                            {% endif %}
                          </span>
                        </div>
                        <hr class="metafield-divider">
                      {% endfor %}
                    {% endif %}
                  {% endif %}
                  
                  <!-- Fallback if no metafields found -->
                  {% unless has_metafields %}
                    <p class="info-placeholder">{{ section.settings.empty_metafields_message | default: 'No additional information available for this product.' }}</p>
                  {% endunless %}
                  
                </div>
              </div>
              
            </div>
          </div>
          
          <!-- ========================================== -->
          <!-- TAB 2: FAQ (Dynamic from Metaobject)       -->
          <!-- ========================================== -->
          <div class="tab-panel" id="faq" role="tabpanel">
            <div class="faq-content">
              
              {% assign metaobject_type = section.settings.metaobject_type | default: 'faq' %}
              {% assign faq_entries = product.metafields[metaobject_type] %}
              
              {% if faq_entries.value.size > 0 %}
                <div class="faq-list">
                  {% for entry in faq_entries.value %}
                    <div class="faq-item">
                      <div class="faq-question" data-toggle="collapse">
                        <span>
                          {% if entry.question %}
                            {{ entry.question }}
                          {% elsif entry.title %}
                            {{ entry.title }}
                          {% elsif entry.name %}
                            {{ entry.name }}
                          {% else %}
                            Question {{ forloop.index }}
                          {% endif %}
                        </span>
                        <span class="faq-toggle">+</span>
                      </div>
                      <div class="faq-answer" style="display: none;">
                        {% if entry.answer %}
                          {{ entry.answer }}
                        {% elsif entry.content %}
                          {{ entry.content }}
                        {% elsif entry.description %}
                          {{ entry.description }}
                        {% else %}
                          No answer provided.
                        {% endif %}
                      </div>
                    </div>
                  {% endfor %}
                </div>
                
              {% elsif product.metafields.custom.faq %}
                <!-- Alternative: Single JSON metafield for FAQ -->
                {% assign faq_json = product.metafields.custom.faq.value %}
                {% if faq_json %}
                  <div class="faq-list">
                    {% for item in faq_json %}
                      <div class="faq-item">
                        <div class="faq-question" data-toggle="collapse">
                          <span>{{ item.question }}</span>
                          <span class="faq-toggle">+</span>
                        </div>
                        <div class="faq-answer" style="display: none;">
                          {{ item.answer }}
                        </div>
                      </div>
                    {% endfor %}
                  </div>
                {% else %}
                  <p class="faq-placeholder">{{ section.settings.empty_faq_message | default: 'No FAQ items found for this product.' }}</p>
                {% endif %}
                
              {% else %}
                <p class="faq-placeholder">{{ section.settings.empty_faq_message | default: 'No FAQ items found for this product.' }}</p>
              {% endif %}
              
            </div>
          </div>
          
        </div>
      </div>
    </div>
  </div>

  <style>
    .product-tabs-section {
      margin: 40px 0;
      padding: 0 20px;
    }
    .product-tabs-section .page-width {
      max-width: 1200px;
      margin: 0 auto;
    }
    
    /* Tabs Navigation */
    .tabs-nav {
      display: flex;
      list-style: none;
      padding: 0;
      margin: 0 0 20px 0;
      border-bottom: 2px solid #eaeaea;
      flex-wrap: wrap;
    }
    .tab-item {
      padding: 14px 28px;
      cursor: pointer;
      font-weight: 700;
      font-size: 20px;
      color: #888;
      border-bottom: 3px solid transparent;
      margin-bottom: -2px;
      transition: all 0.3s ease;
      user-select: none;
    }
    .tab-item.active {
      color: #000;
      border-bottom-color: #000;
    }
    .tab-item:hover {
      color: #000;
    }
    
    .tab-panel {
      display: none;
      padding: 20px 0;
      animation: fadeIn 0.3s ease;
    }
    .tab-panel.active {
      display: block;
    }
    
    /* Info Block Styles */
    .additional-info-content .info-block {
      margin-bottom: 25px;
    }
    .additional-info-content .info-title {
      font-size: 22px;
      font-weight: 600;
      margin-bottom: 20px;
      color: #000;
    }
    
    .info-placeholder {
      color: #999;
      font-style: italic;
      padding: 20px 0;
      text-align: center;
    }
    
    /* Metafields Grid */
    .metafields-grid {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .metafield-item {
      display: flex;
      padding: 12px 0;
      align-items: flex-start;
    }
    .metafield-label {
      font-weight: 600;
      min-width: 200px;
      color: #000;
      font-size: 16px;
    }
    .metafield-value {
      color: #333;
      flex: 1;
      font-size: 16px;
      line-height: 1.6;
    }
    .metafield-value img {
      max-width: 150px;
      height: auto;
      border-radius: 4px;
      border: 1px solid #eaeaea;
    }
    .metafield-json-list {
      margin: 0;
      padding-left: 20px;
    }
    .metafield-json-list li {
      margin-bottom: 8px;
    }
    
    .metafield-divider {
      border: none;
      border-top: 1px solid #eaeaea;
      margin: 0;
      height: 0;
    }
    
    /* FAQ Styles */
    .faq-item {
      border-bottom: 1px solid #eaeaea;
      padding: 16px 0;
    }
    .faq-item:last-child {
      border-bottom: none;
    }
    .faq-question {
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      font-weight: 600;
      font-size: 17px;
      padding: 4px 0;
      color: #000;
    }
    .faq-question:hover {
      color: #333;
    }
    .faq-question .faq-toggle {
      font-size: 26px;
      font-weight: 300;
      transition: transform 0.3s ease;
      color: #888;
      line-height: 1;
    }
    .faq-question.active .faq-toggle {
      transform: rotate(45deg);
      color: #000;
    }
    .faq-answer {
      padding-top: 16px;
      color: #555;
      line-height: 1.8;
      font-size: 16px;
    }
    .faq-answer p {
      margin: 5px 0;
    }
    .faq-placeholder {
      color: #999;
      font-style: italic;
      padding: 20px 0;
      text-align: center;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    @media (max-width: 768px) {
      .tab-item {
        padding: 12px 18px;
        font-size: 16px;
        flex: 1;
        text-align: center;
      }
      .product-tabs-section {
        margin: 20px 0;
        padding: 0 12px;
      }
      .faq-question {
        font-size: 15px;
      }
      .additional-info-content .info-title {
        font-size: 18px;
      }
      .metafield-item {
        flex-direction: column;
        padding: 10px 0;
      }
      .metafield-label {
        min-width: auto;
        margin-bottom: 4px;
        font-size: 14px;
      }
      .metafield-value {
        font-size: 14px;
      }
      .metafield-value img {
        max-width: 100px;
      }
    }
  </style>

  <script>
    (function() {
      const sectionId = {{ section.id | json }};
      const container = document.querySelector(`[data-section-id="${sectionId}"]`);
      if (!container) return;
      
      // Tab switching
      const tabs = container.querySelectorAll('.tab-item');
      const panels = container.querySelectorAll('.tab-panel');
      
      tabs.forEach(tab => {
        tab.addEventListener('click', function() {
          tabs.forEach(t => t.classList.remove('active'));
          this.classList.add('active');
          
          const tabId = this.dataset.tab;
          panels.forEach(panel => {
            panel.classList.toggle('active', panel.id === tabId);
          });
        });
      });
      
      // FAQ toggle
      const faqQuestions = container.querySelectorAll('.faq-question');
      faqQuestions.forEach(question => {
        question.addEventListener('click', function() {
          this.classList.toggle('active');
          const answer = this.nextElementSibling;
          if (answer && answer.classList.contains('faq-answer')) {
            if (answer.style.display === 'none' || answer.style.display === '') {
              answer.style.display = 'block';
            } else {
              answer.style.display = 'none';
            }
          }
        });
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Product Dynamic Tabs",
  "class": "shopify-section-product-tabs",
  "settings": [
    {
      "type": "header",
      "content": "📑 Tab Labels"
    },
    {
      "type": "text",
      "id": "tab_1_label",
      "label": "Additional Information Tab Label",
      "default": "Additional Information"
    },
    {
      "type": "text",
      "id": "tab_2_label",
      "label": "FAQ Tab Label",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "header",
      "content": "📋 Additional Information (Metafields)"
    },
    {
      "type": "text",
      "id": "metafields_title",
      "label": "Section Title",
      "default": "Product Details"
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield Namespace",
      "default": "custom",
      "info": "Default is 'custom' (product.metafields.custom)"
    },
    {
      "type": "text",
      "id": "metafield_keys",
      "label": "Metafield Keys (comma-separated)",
      "default": "material, dimensions, weight",
      "placeholder": "e.g., material, dimensions, weight, color",
      "info": "Leave empty to auto-detect all metafields"
    },
    {
      "type": "text",
      "id": "empty_metafields_message",
      "label": "Empty Metafields Message",
      "default": "No additional information available for this product."
    },
    {
      "type": "header",
      "content": "❓ FAQ (Metaobject)"
    },
    {
      "type": "text",
      "id": "metaobject_type",
      "label": "Metaobject Type Handle",
      "default": "faq",
      "placeholder": "e.g., faq, product_faq",
      "info": "The handle of your metaobject definition"
    },
    {
      "type": "text",
      "id": "empty_faq_message",
      "label": "Empty FAQ Message",
      "default": "No FAQ items found for this product."
    }
  ],
  "presets": [
    {
      "name": "Product Dynamic Tabs",
      "category": "Product",
      "settings": {
        "tab_1_label": "Additional Information",
        "tab_2_label": "Frequently Asked Questions",
        "metafield_namespace": "custom",
        "metafield_keys": "material, dimensions, weight",
        "metaobject_type": "faq"
      }
    }
  ]
}
{% endschema %}