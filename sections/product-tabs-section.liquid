{% if product %}
  <div class="product-tabs-section" data-section-id="{{ section.id }}" data-section-type="product-tabs">
    <div class="page-width">
      
      <div class="tabs-wrapper">
        <ul class="tabs-nav" role="tablist">
          <li class="tab-item active" role="tab" data-tab="additional-info">
            {{ section.settings.tab_1_label | default: 'Additional Information' }}
          </li>
          <li class="tab-item" role="tab" data-tab="faq">
            {{ section.settings.tab_2_label | default: 'Frequently Asked Questions' }}
          </li>
        </ul>
        
        <div class="tabs-content">
          
          <!-- TAB 1: ADDITIONAL INFORMATION -->
          <div class="tab-panel active" id="additional-info" role="tabpanel">
            <div class="additional-info-content">
              <div class="info-block metafields-block">
                <div class="metafields-grid">
                  
                  {% assign has_data = false %}
                  
                  <!-- 1. ADDITIONAL INFORMATION (RICH TEXT SUPPORTED) -->
                  {% assign additional_info = product.metafields.custom.additional_information %}
                  {% if additional_info != blank and additional_info.value != blank %}
                    {% assign has_data = true %}
                    <div class="metafield-item rich-text-content">
                      <div class="metafield-value">
                        {{ additional_info.value }}
                      </div>
                    </div>
                  {% endif %}
                  
                  <!-- 2. SHIPPING CARRIER -->
                  {% assign shipping_carrier = product.metafields.custom.shipping_carrier %}
                  {% if shipping_carrier != blank and shipping_carrier.value != blank %}
                    {% assign has_data = true %}
                    <div class="metafield-item">
                      <span class="metafield-label">Shipping Carrier:</span>
                      <span class="metafield-value">
                        {% if shipping_carrier.value.name != blank %}
                          {{ shipping_carrier.value.name }}
                        {% else %}
                          {{ shipping_carrier.value }}
                        {% endif %}
                      </span>
                    </div>
                  {% endif %}
                  
                  <!-- 3. Dynamic Loop for Other Metafields -->
                  {% for field in product.metafields.custom %}
                    {% assign key = field[0] %}
                    {% assign metafield_obj = field[1] %}
                    
                    {% unless key contains 'faq' or key == 'additional_information' or key == 'shipping_carrier' %}
                      {% if metafield_obj != blank and metafield_obj.value != blank %}
                        {% assign has_data = true %}
                        <div class="metafield-item">
                          <span class="metafield-label">{{ key | replace: '_', ' ' | capitalize }}:</span>
                          <span class="metafield-value">
                            {% if metafield_obj.type contains 'list' %}
                              {% for item in metafield_obj.value %}
                                {{ item }}{% unless forloop.last %}, {% endunless %}
                              {% endfor %}
                            {% else %}
                              {{ metafield_obj.value | newline_to_br }}
                            {% endif %}
                          </span>
                        </div>
                      {% endif %}
                    {% endunless %}
                  {% endfor %}
                  
                  {% unless has_data %}
                    <div class="metafield-item rich-text-content">
                      <div class="metafield-value">{{ product.description }}</div>
                    </div>
                  {% endunless %}
                  
                </div>
              </div>
            </div>
          </div>
          
          <!-- TAB 2: FAQ TAB -->
          <div class="tab-panel" id="faq" role="tabpanel">
            <div class="faq-content">
              {% assign faq_data = product.metafields.custom.faq.value %}
              
              {% if faq_data != blank %}
                <div class="faq-list">
                  {% if product.metafields.custom.faq.type contains 'list' %}
                    {% for item in faq_data %}
                      {% assign q_val = item.questions.value | default: item.questions %}
                      {% assign a_val = item.answers.value | default: item.answers %}
                      
                      {% if q_val != blank %}
                        <div class="faq-item">
                          <div class="faq-question">
                            <span>{{ q_val }}</span>
                            <span class="faq-toggle">+</span>
                          </div>
                          <div class="faq-answer" style="display: none;">
                            {{ a_val | newline_to_br }}
                          </div>
                        </div>
                      {% endif %}
                    {% endfor %}
                  {% else %}
                    {% assign q_val = faq_data.questions.value | default: faq_data.questions %}
                    {% assign a_val = faq_data.answers.value | default: faq_data.answers %}
                    
                    {% if q_val != blank %}
                      <div class="faq-item">
                        <div class="faq-question">
                          <span>{{ q_val }}</span>
                          <span class="faq-toggle">+</span>
                        </div>
                        <div class="faq-answer" style="display: none;">
                          {{ a_val | newline_to_br }}
                        </div>
                      </div>
                    {% endif %}
                  {% endif %}
                </div>
              {% else %}
                <p class="faq-placeholder">No FAQ available for this product.</p>
              {% endif %}
            </div>
          </div>
          
        </div>
      </div>
    </div>
  </div>

  <style>
    .product-tabs-section { margin: 40px 0; padding: 0 20px; }
    .product-tabs-section .page-width { max-width: 1200px; margin: 0 auto; }
    .tabs-nav { display: flex; list-style: none; padding: 0; margin: 0 0 20px 0; border-bottom: 2px solid #eaeaea; flex-wrap: wrap; }
    .tab-item { padding: 14px 28px; cursor: pointer; font-weight: 700; font-size: 20px; color: #888; border-bottom: 3px solid transparent; margin-bottom: -2px; transition: all 0.3s ease; user-select: none; }
    .tab-item.active { color: #000; border-bottom-color: #000; }
    .tab-item:hover { color: #000; }
    .tab-panel { display: none; padding: 20px 0; animation: fadeIn 0.3s ease; }
    .tab-panel.active { display: block; }
    .metafields-grid { display: flex; flex-direction: column; gap: 0; }
    .metafield-item { display: flex; padding: 12px 0; align-items: flex-start; border-bottom: 1px solid #f0f0f0; }
    .metafield-item.rich-text-content { border-bottom: none; padding: 0; }
    .metafield-item:last-child { border-bottom: none; }
    .metafield-label { font-weight: 600; min-width: 200px; color: #000; font-size: 16px; flex-shrink: 0; }
    .metafield-value { color: #333; flex: 1; font-size: 16px; line-height: 1.6; }
    .metafield-value ul, .metafield-value ol { padding-left: 20px; margin: 10px 0; }
    .faq-item { border-bottom: 1px solid #eaeaea; padding: 16px 0; }
    .faq-item:last-child { border-bottom: none; }
    .faq-question { display: flex; justify-content: space-between; align-items: center; cursor: pointer; font-weight: 600; font-size: 17px; padding: 4px 0; color: #000; }
    .faq-question .faq-toggle { font-size: 26px; font-weight: 300; transition: transform 0.3s ease; color: #888; line-height: 1; }
    .faq-question.active .faq-toggle { transform: rotate(45deg); color: #000; }
    .faq-answer { padding-top: 16px; color: #555; line-height: 1.8; font-size: 16px; }
    .faq-placeholder { color: #999; font-style: italic; padding: 20px 0; text-align: center; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @media (max-width: 768px) {
      .tab-item { padding: 12px 18px; font-size: 16px; flex: 1; text-align: center; }
      .product-tabs-section { margin: 20px 0; padding: 0 12px; }
      .metafield-item { flex-direction: column; padding: 10px 0; }
      .metafield-label { min-width: auto; margin-bottom: 4px; font-size: 14px; }
      .metafield-value { font-size: 14px; }
    }
  </style>

  <script>
    (function() {
      const sectionId = {{ section.id | json }};
      const container = document.querySelector(`[data-section-id="${sectionId}"]`);
      if (!container) return;
      
      const tabs = container.querySelectorAll('.tab-item');
      const panels = container.querySelectorAll('.tab-panel');
      
      tabs.forEach(tab => {
        tab.addEventListener('click', function() {
          tabs.forEach(t => t.classList.remove('active'));
          this.classList.add('active');
          
          const tabId = this.dataset.tab;
          panels.forEach(panel => {
            panel.classList.toggle('active', panel.id === tabId);
          });
        });
      });
      
      const faqQuestions = container.querySelectorAll('.faq-question');
      faqQuestions.forEach(question => {
        question.addEventListener('click', function() {
          this.classList.toggle('active');
          const answer = this.nextElementSibling;
          if (answer && answer.classList.contains('faq-answer')) {
            answer.style.display = (answer.style.display === 'none' || answer.style.display === '') ? 'block' : 'none';
          }
        });
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Product Dynamic Tabs",
  "class": "shopify-section-product-tabs",
  "settings": [
    {
      "type": "header",
      "content": "📑 Tab Labels"
    },
    {
      "type": "text",
      "id": "tab_1_label",
      "label": "Additional Information Tab Label",
      "default": "Additional Information"
    },
    {
      "type": "text",
      "id": "tab_2_label",
      "label": "FAQ Tab Label",
      "default": "Frequently Asked Questions"
    }
  ],
  "presets": [
    {
      "name": "Product Dynamic Tabs",
      "category": "Product",
      "settings": {
        "tab_1_label": "Additional Information",
        "tab_2_label": "Frequently Asked Questions"
      }
    }
  ]
}
{% endschema %}