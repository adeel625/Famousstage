{% if product %}

  <div
    class="product-tabs-section"
    data-section-id="{{ section.id }}"
  >

    <div class="page-width">

      <!-- SECTION TITLE -->
      {% if section.settings.section_title != blank %}
        <h2 class="section-title">
          {{ section.settings.section_title }}
        </h2>
      {% endif %}


      <!-- =========================
           TABS NAVIGATION
      ========================== -->

      <div class="tabs-wrapper">

        <ul class="tabs-nav" role="tablist">

          <li
            class="tab-item active"
            role="tab"
            data-tab="additional-info-{{ section.id }}"
          >
            {{ section.settings.tab_1_label | default: 'Additional Information' }}
          </li>

          <li
            class="tab-item"
            role="tab"
            data-tab="faq-{{ section.id }}"
          >
            {{ section.settings.tab_2_label | default: 'FAQ' }}
          </li>

        </ul>


        <!-- =========================
             TABS CONTENT
        ========================== -->

        <div class="tabs-content">


          <!-- =====================================
               ADDITIONAL INFORMATION TAB
          ====================================== -->

          <div
            class="tab-panel active"
            id="additional-info-{{ section.id }}"
            role="tabpanel"
          >

            <div class="product-information-content">

              {% assign has_product_information = false %}

              {% for block in section.blocks %}

                {% if block.type == 'product_information' %}

                  {% assign has_product_information = true %}

                  <div
                    class="product-information-block"
                    {{ block.shopify_attributes }}
                  >

                    <!-- PRODUCT INFORMATION TITLE -->

                    {% if block.settings.title != blank %}

                      <h3 class="product-information-title">
                        {{ block.settings.title }}
                      </h3>

                    {% endif %}


                    <!-- PRODUCT INFORMATION DESCRIPTION -->

                    {% if block.settings.description != blank %}

                      <div class="product-information-description">
                        {{ block.settings.description }}
                      </div>

                    {% endif %}

                  </div>

                {% endif %}

              {% endfor %}


              <!-- FALLBACK -->

              {% unless has_product_information %}

                <div class="product-information-empty">

                  <p>
                    Add a <strong>Product Information</strong> block
                    from the Theme Editor.
                  </p>

                </div>

              {% endunless %}

            </div>

          </div>



          <!-- =====================================
               FAQ TAB
          ====================================== -->

          <div
            class="tab-panel"
            id="faq-{{ section.id }}"
            role="tabpanel"
          >

            <div class="faq-content">

              {% assign has_faq = false %}


              {% for block in section.blocks %}

                {% if block.type == 'faq_item' %}

                  {% assign has_faq = true %}

                  <div
                    class="faq-item"
                    {{ block.shopify_attributes }}
                  >

                    <!-- QUESTION -->

                    <button
                      type="button"
                      class="faq-question"
                      aria-expanded="false"
                    >

                      <span class="faq-question-text">
                        {{ block.settings.question }}
                      </span>

                      <span class="faq-toggle">
                        +
                      </span>

                    </button>


                    <!-- ANSWER -->

                    <div
                      class="faq-answer"
                      hidden
                    >

                      {{ block.settings.answer }}

                    </div>

                  </div>

                {% endif %}

              {% endfor %}


              <!-- NO FAQ MESSAGE -->

              {% unless has_faq %}

                <p class="faq-placeholder">
                  {{ section.settings.empty_message }}
                </p>

              {% endunless %}

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>



  <style>

    /* =========================================
       MAIN SECTION
    ========================================= */

    .product-tabs-section {
      margin: 40px 0;
      padding: 0 20px;
    }


    .product-tabs-section .page-width {
      max-width: 1200px;
      margin: 0 auto;
    }


    /* =========================================
       SECTION TITLE
    ========================================= */

    .product-tabs-section .section-title {
      text-align: center;
      font-size: 28px;
      font-weight: 700;
      margin: 0 0 30px;
      color: #000;
    }


    /* =========================================
       TABS
    ========================================= */

    .product-tabs-section .tabs-nav {
      display: flex;
      list-style: none;
      padding: 0;
      margin: 0 0 20px;
      border-bottom: 2px solid #eaeaea;
      flex-wrap: wrap;
    }


    .product-tabs-section .tab-item {
      padding: 12px 24px;
      cursor: pointer;
      font-weight: 600;
      color: #666;
      border-bottom: 3px solid transparent;
      margin-bottom: -2px;
      transition: all 0.3s ease;
      user-select: none;
    }


    .product-tabs-section .tab-item:hover {
      color: #000;
    }


    .product-tabs-section .tab-item.active {
      color: #000;
      border-bottom-color: #000;
    }


    /* =========================================
       TAB PANELS
    ========================================= */

    .product-tabs-section .tab-panel {
      display: none;
      padding: 20px 0;
      animation: productTabsFadeIn 0.3s ease;
    }


    .product-tabs-section .tab-panel.active {
      display: block;
    }


    /* =========================================
       PRODUCT INFORMATION
    ========================================= */

    .product-information-block {
      margin-bottom: 30px;
    }


    .product-information-block:last-child {
      margin-bottom: 0;
    }


    .product-information-title {
      margin: 0 0 15px;
      font-size: 22px;
      line-height: 1.3;
      font-weight: 600;
      color: #000;
    }


    .product-information-description {
      font-size: 16px;
      line-height: 1.8;
      color: #333;
    }


    .product-information-description p {
      margin: 0 0 15px;
    }


    .product-information-description p:last-child {
      margin-bottom: 0;
    }


    .product-information-description ul,
    .product-information-description ol {
      padding-left: 25px;
      margin-bottom: 15px;
    }


    .product-information-description img {
      max-width: 100%;
      height: auto;
    }


    /* =========================================
       EMPTY PRODUCT INFORMATION
    ========================================= */

    .product-information-empty {
      padding: 20px 0;
      color: #999;
      font-style: italic;
    }


    /* =========================================
       FAQ
    ========================================= */

    .faq-item {
      border-bottom: 1px solid #eaeaea;
    }


    .faq-item:last-child {
      border-bottom: none;
    }


    /* =========================================
       FAQ QUESTION
    ========================================= */

    .faq-question {
      width: 100%;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 20px;

      padding: 18px 0;

      background: transparent;
      border: 0;
      outline: none;

      cursor: pointer;

      text-align: left;

      font-family: inherit;
      font-size: 16px;
      font-weight: 600;

      color: #000;
    }


    .faq-question:hover {
      color: #333;
    }


    .faq-question-text {
      flex: 1;
    }


    /* =========================================
       FAQ PLUS ICON
    ========================================= */

    .faq-toggle {
      flex: 0 0 auto;

      width: 28px;
      height: 28px;

      display: flex;
      align-items: center;
      justify-content: center;

      font-size: 24px;
      font-weight: 400;

      line-height: 1;

      color: #333;

      transition: transform 0.3s ease;
    }


    .faq-question.active .faq-toggle {
      transform: rotate(45deg);
    }


    /* =========================================
       FAQ ANSWER
    ========================================= */

    .faq-answer {
      padding: 0 40px 18px 0;

      font-size: 15px;
      line-height: 1.8;

      color: #555;

      animation: faqFadeIn 0.25s ease;
    }


    .faq-answer p {
      margin: 0 0 10px;
    }


    .faq-answer p:last-child {
      margin-bottom: 0;
    }


    /* =========================================
       EMPTY FAQ
    ========================================= */

    .faq-placeholder {
      padding: 20px 0;
      text-align: center;

      color: #999;
      font-style: italic;
    }


    /* =========================================
       ANIMATIONS
    ========================================= */

    @keyframes productTabsFadeIn {

      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }

    }


    @keyframes faqFadeIn {

      from {
        opacity: 0;
      }

      to {
        opacity: 1;
      }

    }


    /* =========================================
       MOBILE
    ========================================= */

    @media (max-width: 768px) {

      .product-tabs-section {
        margin: 20px 0;
        padding: 0 12px;
      }


      .product-tabs-section .section-title {
        font-size: 22px;
        margin-bottom: 20px;
      }


      .product-tabs-section .tab-item {
        flex: 1;
        text-align: center;
        padding: 10px 16px;
        font-size: 14px;
      }


      .product-information-title {
        font-size: 20px;
      }


      .product-information-description {
        font-size: 15px;
      }


      .faq-question {
        font-size: 14px;
        padding: 15px 0;
      }


      .faq-answer {
        font-size: 14px;
        padding-right: 25px;
      }

    }

  </style>



  <script>

    (function() {

      const container = document.querySelector(
        '[data-section-id="{{ section.id }}"]'
      );

      if (!container) return;


      /* =====================================
         TAB SWITCHING
      ====================================== */

      const tabs = container.querySelectorAll('.tab-item');

      const panels = container.querySelectorAll('.tab-panel');


      tabs.forEach(function(tab) {

        tab.addEventListener('click', function() {

          const targetId = this.getAttribute('data-tab');


          /* Remove active from all tabs */

          tabs.forEach(function(item) {

            item.classList.remove('active');

          });


          /* Add active to clicked tab */

          this.classList.add('active');


          /* Switch panel */

          panels.forEach(function(panel) {

            if (panel.id === targetId) {

              panel.classList.add('active');

            } else {

              panel.classList.remove('active');

            }

          });

        });

      });



      /* =====================================
         FAQ ACCORDION
      ====================================== */

      const faqQuestions = container.querySelectorAll(
        '.faq-question'
      );


      faqQuestions.forEach(function(question) {

        question.addEventListener('click', function() {

          const answer = this.nextElementSibling;

          if (!answer) return;


          const isOpen =
            this.getAttribute('aria-expanded') === 'true';


          if (isOpen) {

            /* CLOSE */

            this.setAttribute(
              'aria-expanded',
              'false'
            );

            this.classList.remove('active');

            answer.hidden = true;

          } else {

            /* OPEN */

            this.setAttribute(
              'aria-expanded',
              'true'
            );

            this.classList.add('active');

            answer.hidden = false;

          }

        });

      });

    })();

  </script>

{% endif %}



{% schema %}

{
  "name": "Product Tabs Section",

  "class": "shopify-section-product-tabs",

  "settings": [

    {
      "type": "header",
      "content": "Section Settings"
    },

    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Product Information",
      "info": "Leave empty to hide"
    },


    {
      "type": "header",
      "content": "Tab Labels"
    },

    {
      "type": "text",
      "id": "tab_1_label",
      "label": "Tab 1 Label",
      "default": "Additional Information"
    },

    {
      "type": "text",
      "id": "tab_2_label",
      "label": "Tab 2 Label",
      "default": "FAQ"
    },


    {
      "type": "header",
      "content": "FAQ Settings"
    },

    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty FAQ Message",
      "default": "No FAQ items added yet. Click Add block to add an FAQ."
    }

  ],


  "blocks": [

    {
      "type": "product_information",

      "name": "Product Information",

      "settings": [

        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Product Details"
        },

        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Add your product information here.</p>"
        }

      ]
    },


    {
      "type": "faq_item",

      "name": "FAQ Item",

      "settings": [

        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your return policy?"
        },

        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We offer a 30-day return policy for all products.</p>"
        }

      ]
    }

  ],


  "presets": [

    {
      "name": "Product Tabs Section",

      "category": "Product",

      "blocks": [

        {
          "type": "product_information",

          "settings": {

            "title": "Product Details",

            "description": "<p>Add your product details and information here.</p>"

          }
        },

        {
          "type": "faq_item",

          "settings": {

            "question": "What is your return policy?",

            "answer": "<p>We offer a 30-day return policy for all products.</p>"

          }
        },

        {
          "type": "faq_item",

          "settings": {

            "question": "How long does shipping take?",

            "answer": "<p>Shipping typically takes 3-5 business days.</p>"

          }
        },

        {
          "type": "faq_item",

          "settings": {

            "question": "Do you offer international shipping?",

            "answer": "<p>Yes, we ship worldwide. Shipping costs vary by location.</p>"

          }
        }

      ]
    }

  ]

}

{% endschema %}