<div class="social-icons-block">
  {% if block.settings.title != blank %}
    <h3 class="social-icons-title" style="font-size: 16px; font-weight: 600; margin-bottom: 15px;">
      {{ block.settings.title }}
    </h3>
  {% endif %}

