{% if product %}
  <div
    class="product-tabs-section"
    data-section-id="{{ section.id }}"
    data-section-type="product-tabs"
  >
    <div class="page-width">

      {% if section.settings.section_title != blank %}
        <h2 class="section-title">
          {{ section.settings.section_title }}
        </h2>
      {% endif %}

      <div class="tabs-wrapper">

        <!-- TABS -->
        <ul class="tabs-nav" role="tablist">

          <li
            class="tab-item active"
            role="tab"
            data-tab="additional-info-{{ section.id }}"
          >
            {{ section.settings.tab_1_label | default: 'Additional Information' }}
          </li>

          <li
            class="tab-item"
            role="tab"
            data-tab="faq-{{ section.id }}"
          >
            {{ section.settings.tab_2_label | default: 'FAQ' }}
          </li>

        </ul>


        <div class="tabs-content">

          <!-- ================================= -->
          <!-- ADDITIONAL INFORMATION TAB -->
          <!-- ================================= -->

          <div
            class="tab-panel active"
            id="additional-info-{{ section.id }}"
            role="tabpanel"
          >

            <div class="additional-info-content">

              <!-- EDITABLE TITLE -->
              {% if section.settings.info_title != blank %}
                <h3 class="info-title">
                  {{ section.settings.info_title }}
                </h3>
              {% endif %}


              <!-- EDITABLE DESCRIPTION -->
              {% if section.settings.info_description != blank %}

                <div class="info-description">
                  {{ section.settings.info_description }}
                </div>

              {% else %}

                <!-- PRODUCT DESCRIPTION FALLBACK -->
                <div class="info-description">
                  {{ product.description }}
                </div>

              {% endif %}

            </div>

          </div>


          <!-- ================================= -->
          <!-- FAQ TAB -->
          <!-- ================================= -->

          <div
            class="tab-panel"
            id="faq-{{ section.id }}"
            role="tabpanel"
          >

            <div class="faq-content">

              {% if section.blocks.size > 0 %}

                {% for block in section.blocks %}

                  <div
                    class="faq-item"
                    {{ block.shopify_attributes }}
                  >

                    <!-- QUESTION -->
                    <button
                      type="button"
                      class="faq-question"
                      aria-expanded="false"
                    >

                      <span class="faq-question-text">
                        {{ block.settings.question }}
                      </span>

                      <span class="faq-toggle">
                        +
                      </span>

                    </button>


                    <!-- ANSWER -->
                    <div
                      class="faq-answer"
                      hidden
                    >

                      {{ block.settings.answer }}

                    </div>

                  </div>

                {% endfor %}

              {% else %}

                <p class="faq-placeholder">
                  {{ section.settings.empty_message | default: 'No FAQ items added yet. Click "Add block" to add an FAQ.' }}
                </p>

              {% endif %}

            </div>

          </div>

        </div>

      </div>

    </div>
  </div>


  <style>

    /* ================================
       MAIN SECTION
    ================================= */

    .product-tabs-section {
      margin: 40px 0;
      padding: 0 20px;
    }

    .product-tabs-section .page-width {
      max-width: 1200px;
      margin: 0 auto;
    }


    /* ================================
       SECTION TITLE
    ================================= */

    .product-tabs-section .section-title {
      text-align: center;
      font-size: 28px;
      font-weight: 700;
      margin: 0 0 30px;
      color: #000;
    }


    /* ================================
       TABS
    ================================= */

    .product-tabs-section .tabs-nav {
      display: flex;
      list-style: none;
      padding: 0;
      margin: 0 0 20px;
      border-bottom: 2px solid #eaeaea;
      flex-wrap: wrap;
    }

    .product-tabs-section .tab-item {
      padding: 12px 24px;
      cursor: pointer;
      font-weight: 600;
      color: #666;
      border-bottom: 3px solid transparent;
      margin-bottom: -2px;
      transition: all 0.3s ease;
      user-select: none;
    }

    .product-tabs-section .tab-item:hover {
      color: #000;
    }

    .product-tabs-section .tab-item.active {
      color: #000;
      border-bottom-color: #000;
    }


    /* ================================
       TAB PANELS
    ================================= */

    .product-tabs-section .tab-panel {
      display: none;
      padding: 20px 0;
      animation: productTabsFadeIn 0.3s ease;
    }

    .product-tabs-section .tab-panel.active {
      display: block;
    }


    /* ================================
       ADDITIONAL INFORMATION
    ================================= */

    .product-tabs-section .info-title {
      font-size: 22px;
      font-weight: 600;
      margin: 0 0 15px;
      color: #000;
    }

    .product-tabs-section .info-description {
      color: #333;
      line-height: 1.8;
      font-size: 16px;
    }

    .product-tabs-section .info-description p {
      margin: 0 0 15px;
    }

    .product-tabs-section .info-description ul,
    .product-tabs-section .info-description ol {
      margin-bottom: 15px;
      padding-left: 25px;
    }

    .product-tabs-section .info-description img {
      max-width: 100%;
      height: auto;
    }


    /* ================================
       FAQ
    ================================= */

    .product-tabs-section .faq-item {
      border-bottom: 1px solid #eaeaea;
    }

    .product-tabs-section .faq-item:last-child {
      border-bottom: none;
    }


    /* FAQ QUESTION */

    .product-tabs-section .faq-question {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;

      padding: 18px 0;

      background: transparent;
      border: 0;
      outline: none;

      cursor: pointer;

      text-align: left;

      font-family: inherit;
      font-size: 16px;
      font-weight: 600;

      color: #000;
    }

    .product-tabs-section .faq-question:hover {
      color: #333;
    }


    /* QUESTION TEXT */

    .product-tabs-section .faq-question-text {
      flex: 1;
    }


    /* PLUS ICON */

    .product-tabs-section .faq-toggle {
      flex: 0 0 auto;

      width: 28px;
      height: 28px;

      display: flex;
      align-items: center;
      justify-content: center;

      font-size: 24px;
      font-weight: 400;

      line-height: 1;

      color: #333;

      transition: transform 0.3s ease;
    }


    /* OPEN ICON */

    .product-tabs-section .faq-question.active .faq-toggle {
      transform: rotate(45deg);
    }


    /* FAQ ANSWER */

    .product-tabs-section .faq-answer {
      padding: 0 40px 18px 0;

      color: #555;

      font-size: 15px;
      line-height: 1.8;

      animation: faqAnswerFadeIn 0.25s ease;
    }

    .product-tabs-section .faq-answer p {
      margin: 0 0 10px;
    }

    .product-tabs-section .faq-answer p:last-child {
      margin-bottom: 0;
    }


    /* EMPTY MESSAGE */

    .product-tabs-section .faq-placeholder {
      color: #999;
      font-style: italic;
      padding: 20px 0;
      text-align: center;
    }


    /* ================================
       ANIMATIONS
    ================================= */

    @keyframes productTabsFadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes faqAnswerFadeIn {
      from {
        opacity: 0;
      }

      to {
        opacity: 1;
      }
    }


    /* ================================
       MOBILE
    ================================= */

    @media (max-width: 768px) {

      .product-tabs-section {
        margin: 20px 0;
        padding: 0 12px;
      }

      .product-tabs-section .section-title {
        font-size: 22px;
        margin-bottom: 20px;
      }

      .product-tabs-section .tab-item {
        padding: 10px 16px;
        font-size: 14px;
        flex: 1;
        text-align: center;
      }

      .product-tabs-section .info-title {
        font-size: 20px;
      }

      .product-tabs-section .info-description {
        font-size: 15px;
      }

      .product-tabs-section .faq-question {
        font-size: 14px;
        padding: 15px 0;
      }

      .product-tabs-section .faq-answer {
        font-size: 14px;
        padding-right: 25px;
      }

    }

  </style>


  <script>

    (function() {

      const container = document.querySelector(
        '[data-section-id="{{ section.id }}"]'
      );

      if (!container) return;


      /* =================================
         TAB SWITCHING
      ================================= */

      const tabs = container.querySelectorAll('.tab-item');

      const panels = container.querySelectorAll('.tab-panel');


      tabs.forEach(function(tab) {

        tab.addEventListener('click', function() {

          const targetId = this.getAttribute('data-tab');


          /* Remove active from all tabs */

          tabs.forEach(function(item) {
            item.classList.remove('active');
          });


          /* Add active to clicked tab */

          this.classList.add('active');


          /* Switch panels */

          panels.forEach(function(panel) {

            if (panel.id === targetId) {

              panel.classList.add('active');

            } else {

              panel.classList.remove('active');

            }

          });

        });

      });


      /* =================================
         FAQ ACCORDION
      ================================= */

      const faqQuestions = container.querySelectorAll(
        '.faq-question'
      );


      faqQuestions.forEach(function(question) {

        question.addEventListener('click', function() {

          const answer = this.nextElementSibling;

          if (!answer) return;


          const isOpen = this.getAttribute('aria-expanded') === 'true';


          /* Toggle */

          if (isOpen) {

            this.setAttribute('aria-expanded', 'false');

            this.classList.remove('active');

            answer.hidden = true;

          } else {

            this.setAttribute('aria-expanded', 'true');

            this.classList.add('active');

            answer.hidden = false;

          }

        });

      });

    })();

  </script>

{% endif %}


{% schema %}

{
  "name": "Product Tabs Section",

  "class": "shopify-section-product-tabs",

  "settings": [

    {
      "type": "header",
      "content": "Section Settings"
    },

    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Product Information",
      "info": "Leave empty to hide"
    },


    {
      "type": "header",
      "content": "Tab Labels"
    },

    {
      "type": "text",
      "id": "tab_1_label",
      "label": "Tab 1 Label",
      "default": "Additional Information"
    },

    {
      "type": "text",
      "id": "tab_2_label",
      "label": "Tab 2 Label",
      "default": "FAQ"
    },


    {
      "type": "header",
      "content": "Additional Information"
    },

    {
      "type": "text",
      "id": "info_title",
      "label": "Additional Information Title",
      "default": "Product Details",
      "info": "This title can be edited from the Theme Editor."
    },

    {
      "type": "richtext",
      "id": "info_description",
      "label": "Additional Information Description",
      "default": "<p>Add your product information here.</p>",
      "info": "This description can be edited from the Theme Editor. If empty, the product description will be displayed."
    },


    {
      "type": "header",
      "content": "FAQ Settings"
    },

    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty FAQ Message",
      "default": "No FAQ items added yet. Click Add block to add an FAQ."
    }

  ],


  "blocks": [

    {
      "type": "faq_item",

      "name": "FAQ Item",

      "settings": [

        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your return policy?"
        },

        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We offer a 30-day return policy for all products.</p>"
        }

      ]
    }

  ],


  "presets": [

    {
      "name": "Product Tabs Section",

      "category": "Product",

      "blocks": [

        {
          "type": "faq_item",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>We offer a 30-day return policy for all products.</p>"
          }
        },

        {
          "type": "faq_item",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Shipping typically takes 3-5 business days.</p>"
          }
        },

        {
          "type": "faq_item",
          "settings": {
            "question": "Do you offer international shipping?",
            "answer": "<p>Yes, we ship worldwide. Shipping costs vary by location.</p>"
          }
        }

      ]
    }

  ]

}

{% endschema %}